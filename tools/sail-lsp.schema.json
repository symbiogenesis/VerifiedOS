{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verifiedos.org/schemas/sail-lsp.schema.json",
  "title": "Optional Sail LSP status and qualification",
  "oneOf": [{"$ref": "#/$defs/status"}, {"$ref": "#/$defs/qualification"}],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "operation", "notice", "installed", "home"],
      "properties": {
        "schema_version": {"const": 1}, "operation": {"const": "status"},
        "notice": {"type": "string"}, "installed": {"type": "boolean"}, "home": {"type": "string"},
        "lock_sha256": {"$ref": "#/$defs/digest"}, "server_sha256": {"$ref": "#/$defs/digest"},
        "artifact_count": {"type": "integer", "minimum": 1}, "receipt": {"type": "string"},
        "install_seconds": {"type": "number", "minimum": 0}, "log": {"type": "string"}
      },
      "if": {"properties": {"installed": {"const": true}}},
      "then": {"required": ["lock_sha256", "server_sha256", "artifact_count", "receipt", "install_seconds", "log"]}
    },
    "batch": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["command", "exit_code", "timed_out", "elapsed_seconds", "peak_rss_kib", "log", "log_sha256", "source_sha256"],
      "properties": {
        "command": {"type": "array", "items": {"type": "string"}},
        "exit_code": {"type": "integer"}, "timed_out": {"type": "boolean"},
        "elapsed_seconds": {"type": "number", "minimum": 0},
        "peak_rss_kib": {"type": ["integer", "null"], "minimum": 0},
        "log": {"type": "string"}, "log_sha256": {"$ref": "#/$defs/digest"},
        "source_sha256": {"type": "object", "additionalProperties": {"$ref": "#/$defs/digest"}}
      }
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "passed", "response", "batch", "elapsed_seconds", "required", "live_seconds"],
      "properties": {
        "name": {"type": "string"}, "passed": {"type": "boolean"}, "response": {"type": "object"},
        "batch": {"$ref": "#/$defs/batch"}, "elapsed_seconds": {"type": "number", "minimum": 0},
        "required": {"type": "boolean"}, "live_seconds": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "session": {
      "type": "object", "additionalProperties": false,
      "required": ["exit_code", "shutdown", "elapsed_seconds", "peak_rss_kib", "transcript"],
      "properties": {
        "exit_code": {"type": "integer"}, "shutdown": {"type": ["object", "null"]},
        "elapsed_seconds": {"type": "number", "minimum": 0},
        "peak_rss_kib": {"type": "integer", "minimum": 0}, "transcript": {"type": "string"}
      }
    },
    "qualification": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "operation", "notice", "installation", "cases", "sessions", "all_capabilities_passed", "all_required_checks_passed", "model_source_sha256", "report"],
      "properties": {
        "schema_version": {"const": 1}, "operation": {"const": "qualify"}, "notice": {"type": "string"},
        "installation": {"$ref": "#/$defs/status"},
        "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}},
        "sessions": {"type": "array", "items": {"$ref": "#/$defs/session"}},
        "all_capabilities_passed": {"type": "boolean"},
        "all_required_checks_passed": {"type": "boolean"},
        "model_source_sha256": {"type": "object", "additionalProperties": {"$ref": "#/$defs/digest"}},
        "report": {"type": "string"}
      }
    }
  }
}
