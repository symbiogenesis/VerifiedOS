{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "reviews",
    "template",
    "rows"
  ],
  "properties": {
    "schema": {
      "const": 2,
      "type": "integer"
    },
    "template": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/review"
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/row"
      },
      "contains": {
        "type": "object",
        "required": [
          "id",
          "tool",
          "reviews"
        ],
        "properties": {
          "id": {
            "const": "Verilator"
          },
          "tool": {
            "const": "Verilator"
          },
          "reviews": {
            "contains": {
              "const": "verilator"
            }
          }
        },
        "$comment": "The enforced RTL release must keep its licence-review row even when other tools remain; this preserves the missing-row refusal formerly owned by K-97."
      }
    }
  },
  "$defs": {
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tool",
        "subject",
        "reviewed",
        "owners"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "reviewed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "owners": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/owner"
          }
        }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "key"
      ],
      "properties": {
        "kind": {
          "enum": [
            "uv",
            "uv-required",
            "opam",
            "opam-pin",
            "opam-every",
            "opam-any",
            "assign",
            "shell",
            "pip",
            "pre-commit",
            "pre-commit-rev",
            "python"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tool",
        "license",
        "standing"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "tool": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "[\\r\\n|]"
          }
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "[\\r\\n|]"
          }
        },
        "standing": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "[\\r\\n|]"
          }
        },
        "reviews": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "disposition": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "oneOf": [
        {
          "required": [
            "reviews"
          ],
          "not": {
            "required": [
              "disposition"
            ]
          }
        },
        {
          "required": [
            "disposition"
          ],
          "not": {
            "required": [
              "reviews"
            ]
          }
        }
      ]
    }
  }
}
