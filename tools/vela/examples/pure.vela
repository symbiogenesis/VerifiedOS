// Mathematical naturals and booleans; development prototype, unqualified.
module Oracle;

/// Computes the cube of a natural number.
public const Nat Cube(Nat x,) => x * x * x;

/// Supplies the configured base value.
public const Nat Base = 2;

/// Compares the cubed input using the selected branch.
public bool Choose(bool flag, Nat x)
{
    let Nat y = Cube(x: x + 1,);
    if (flag == true)
    {
        const Nat limit = Cube(x: Base) + 1;
        return y <= limit;
    }
    else
    {
        const Nat limit = 0;
        if (y == limit)
        {
            return true;
        }
        else
        {
            return false;
        }
    }
}
