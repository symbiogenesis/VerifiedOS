// Compositional constants in the mathematical development prototype.
module Constants;

/// Computes the square at compile time or runtime.
public const Nat Square(Nat value) => value * value;

/// Supplies the static gain configuration.
public const Nat Gain = 4;

// The plan is static; samples arrive at runtime.
/// Applies a statically configured multiplier to a runtime sample.
public Nat Scale(const Nat gain, Nat sample)
{
    const Nat multiplier = Square(gain);
    return multiplier * sample;
}

/// Preserves the static gain requirement while forwarding a sample.
public Nat Forward(const Nat gain, Nat sample) => Scale(gain: gain, sample: sample);

/// Processes a sample with the configured gain.
public Nat Process(Nat sample) => Forward(gain: Gain, sample: sample);

/// Evaluates the configured square during compilation.
public const Nat StaticResult = Square(Gain);

/// Calls the same square function with a runtime value.
public Nat RuntimeSquare(Nat value) => Square(value);
