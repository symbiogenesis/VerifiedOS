// SPDX-License-Identifier: Apache-2.0
// Bounded synchronous packet/manifest validator for the Vela first-slice gate (Q25w / Q25ag).
module Vela.FirstSlice;

public union ValidationError
{
    FramingShort();
    BadMagicOrFlags();
    LengthOutOfBounds();
    ChecksumRejected();
}

public record ValidatedPacket<region 'dst>(
    usize CopiedBytes,
    in<'dst> Span<byte> PayloadView);

public definition Span<byte> MakePacket8(
    usize base,
    byte b0,
    byte b1,
    byte b2,
    byte b3,
    byte b4,
    byte b5,
    byte b6,
    byte b7)
    =>
    let s0 = Span.AllocZeroed(base, 8usize) in
    let s1 = Span.Write(s0, 0usize, b0) in
    let s2 = Span.Write(s1, 1usize, b1) in
    let s3 = Span.Write(s2, 2usize, b2) in
    let s4 = Span.Write(s3, 3usize, b3) in
    let s5 = Span.Write(s4, 4usize, b4) in
    let s6 = Span.Write(s5, 5usize, b5) in
    let s7 = Span.Write(s6, 6usize, b6) in
    Span.Write(s7, 7usize, b7);

public Unit WritePacket8(
    ref Span<byte> pkt,
    byte b0,
    byte b1,
    byte b2,
    byte b3,
    byte b4,
    byte b5,
    byte b6,
    byte b7)
    effects writes(pkt)
    requires pkt.CanRead && pkt.CanWrite && pkt.Length >= 8usize
    ensures pkt.Base == old(pkt.Base) && pkt.Length == old(pkt.Length) && pkt.CanRead && pkt.CanWrite
    ensures pkt[0usize] == b0 && pkt[1usize] == b1 && pkt[2usize] == b2 && pkt[3usize] == b3
    ensures pkt[4usize] == b4 && pkt[5usize] == b5 && pkt[6usize] == b6 && pkt[7usize] == b7
{
    pkt[0usize] = b0;
    pkt[1usize] = b1;
    pkt[2usize] = b2;
    pkt[3usize] = b3;
    pkt[4usize] = b4;
    pkt[5usize] = b5;
    pkt[6usize] = b6;
    pkt[7usize] = b7;
}

public definition Span<byte> InhabitedByteSpan()
    =>
    Span.Write(Span.AllocZeroed(0x1000usize, 8usize), 0usize, 0x56u8);

public theorem LawInhabitedByteCase()
    ensures exists (Span<byte> s) =>
        (s.CanRead && s.CanWrite && s.Length == 8usize && s[0usize] == 0x56u8) == true
    proof
    {
        assert exists (Span<byte> s) =>
            (s.CanRead && s.CanWrite && s.Length == 8usize && s[0usize] == 0x56u8) == true
            by InhabitedByteSpan();
    }

public theorem LawAllocZeroedRead(usize base, usize idx)
    ensures (if (idx < 8usize) Span.AllocZeroed(base, 8usize)[idx] == 0x00u8 else true) == true
    proof
    {
        assert (if (idx < 8usize) Span.AllocZeroed(base, 8usize)[idx] == 0x00u8 else true) == true;
    }

public theorem LawReadOverWriteSame(ref Span<byte> s, usize idx, byte val)
    requires s.CanRead && s.CanWrite && idx < s.Length
    ensures (s[idx] == val && s.Base == old(s.Base) && s.Length == old(s.Length) && s.CanRead && s.CanWrite) == true
    proof
    {
        s[idx] = val;
        assert (s[idx] == val && s.Base == old(s.Base) && s.Length == old(s.Length) && s.CanRead && s.CanWrite) == true;
    }

public theorem LawReadOverWriteOther(ref Span<byte> s, usize writeIdx, usize readIdx, byte val)
    requires s.CanRead && s.CanWrite && writeIdx < s.Length && readIdx < s.Length && writeIdx != readIdx
    ensures (s[writeIdx] == val && s[readIdx] == old(s[readIdx])) == true
    proof
    {
        s[writeIdx] = val;
        assert (s[writeIdx] == val && s[readIdx] == old(s[readIdx])) == true;
    }

public theorem LawLoopFramePreservesDisjointSuffix(ref Span<byte> s, usize bound, usize frameIdx, byte fillByte)
    requires s.CanRead && s.CanWrite
    requires bound <= s.Length
    requires frameIdx >= bound && frameIdx < s.Length
    ensures (s.Base == old(s.Base) && s.Length == old(s.Length) && s.CanRead && s.CanWrite && s[frameIdx] == old(s[frameIdx])) == true
    proof
    {
        foreach (let i in 0usize..bound)
            invariant i <= bound
            invariant s.CanRead && s.CanWrite && s.Base == old(s.Base) && s.Length == old(s.Length)
            invariant s[frameIdx] == old(s[frameIdx])
            decreases bound - i
        {
            s[i] = fillByte;
        }
        assert (s.Base == old(s.Base) && s.Length == old(s.Length) && s.CanRead && s.CanWrite && s[frameIdx] == old(s[frameIdx])) == true;
    }

public theorem LawFillAndFrame(ref Span<byte> s, usize frameIdx, byte fillVal)
    requires s.CanRead && s.CanWrite && s.Length >= 8usize
    requires frameIdx >= 6usize && frameIdx < s.Length
    ensures (s[1usize] == old(s[1usize])
        && s[2usize] == fillVal
        && s[5usize] == fillVal
        && s[frameIdx] == old(s[frameIdx])) == true
    proof
    {
        Span.Fill(ref s, 2usize, 4usize, fillVal);
        assert (s[1usize] == old(s[1usize])
            && s[2usize] == fillVal
            && s[5usize] == fillVal
            && s[frameIdx] == old(s[frameIdx])) == true;
    }

public theorem LawSliceMetadataAndRead(in Span<byte> s, usize idx)
    requires s.CanRead && s.Base <= 0xFFFF_0000usize && s.Length >= 8usize && idx < 3usize
    ensures
        let sub = Span.Slice(s, 4usize, 3usize) in
        (sub.Base == s.Base + 4usize
            && sub.Length == 3usize
            && sub.CanRead
            && sub.CanWrite == s.CanWrite
            && sub[idx] == s[4usize + idx]) == true
    proof
    {
        let sub = Span.Slice(s, 4usize, 3usize);
        assert (sub.Base == s.Base + 4usize
            && sub.Length == 3usize
            && sub.CanRead
            && sub.CanWrite == s.CanWrite
            && sub[idx] == s[4usize + idx]) == true;
    }

public theorem LawReadOnlyAndInvalidate(in Span<byte> s)
    requires s.CanRead && s.CanWrite
    ensures
        let ro = Span.ReadOnly(s) in
        let inv = Span.Invalidate(s) in
        (ro.CanRead && !ro.CanWrite && !inv.CanRead && !inv.CanWrite) == true
    proof
    {
        let ro = Span.ReadOnly(s);
        let inv = Span.Invalidate(s);
        assert (ro.CanRead && !ro.CanWrite && !inv.CanRead && !inv.CanWrite) == true;
    }

public theorem LawDisjointCopyAndFrame(ref Span<byte> dst, in Span<byte> src, usize frameIdx)
    requires dst.CanRead && dst.CanWrite && src.CanRead
    requires dst.Length >= 8usize && src.Length >= 6usize
    requires Span.Disjoint(dst, src)
    requires frameIdx >= 6usize && frameIdx < dst.Length
    ensures (dst.Base == old(dst.Base)
        && dst.Length == old(dst.Length)
        && dst[3usize] == old(dst[3usize])
        && dst[4usize] == src[4usize]
        && dst[5usize] == src[5usize]
        && dst[frameIdx] == old(dst[frameIdx])) == true
    proof
    {
        var dstSub = Span.Slice(dst, 4usize, 2usize);
        let srcSub = Span.Slice(src, 4usize, 2usize);
        Span.CopyPrefix(ref dstSub, srcSub, 2usize);
        assert (dst.Base == old(dst.Base)
            && dst.Length == old(dst.Length)
            && dst[3usize] == old(dst[3usize])
            && dst[4usize] == src[4usize]
            && dst[5usize] == src[5usize]
            && dst[frameIdx] == old(dst[frameIdx])) == true;
    }

public Span<byte> PrepareSliceHeader(ref Span<byte> dst)
    effects writes(dst)
    requires dst.CanRead
    requires dst.CanWrite
    requires dst.Length >= 8usize
    ensures dst.Length == old(dst.Length)
    ensures result.Length == 4usize
    ensures !result.CanWrite
{
    foreach (let i in 0usize..dst.Length)
        invariant i <= dst.Length
        invariant dst.CanRead && dst.CanWrite && dst.Base == old(dst.Base) && dst.Length == old(dst.Length)
        decreases dst.Length - i
    {
        dst[i] = 0x00u8;
    }
    dst[0usize] = 0x56u8;
    dst[3usize] = 0x01u8;
    let roView = Span.ReadOnly(Span.Slice(dst, 0usize, 4usize));
    return roView;
}

public theorem LawCapacityInvarianceSmall(ref Span<byte> s)
    requires s.CanRead && s.CanWrite && s.Length == 8usize
    ensures (s.Length == 8usize && s[0usize] == 0x56u8 && s[3usize] == 0x01u8) == true
    proof
    {
        let roView = PrepareSliceHeader(ref s);
        assert (s.Length == 8usize
            && roView.Length == 4usize
            && !roView.CanWrite
            && s[0usize] == 0x56u8
            && s[3usize] == 0x01u8) == true;
    }

public theorem LawCapacityInvarianceLarge(ref Span<byte> s)
    requires s.CanRead && s.CanWrite && s.Length == 1_000_000_000usize
    ensures (s.Length == 1_000_000_000usize && s[0usize] == 0x56u8 && s[3usize] == 0x01u8) == true
    proof
    {
        let roView = PrepareSliceHeader(ref s);
        assert (s.Length == 1_000_000_000usize
            && roView.Length == 4usize
            && !roView.CanWrite
            && s[0usize] == 0x56u8
            && s[3usize] == 0x01u8) == true;
    }

public definition u8 SpecPacketChecksum(in Span<byte> pkt, u8 rawLen, usize payloadLen)
    requires pkt.CanRead
    requires payloadLen <= 4usize
    requires 4usize + payloadLen <= pkt.Length
    =>
    let c0 = 0x5Au8 ^ rawLen in
    let c1 = if (0usize < payloadLen) c0 ^ pkt[4usize] else c0 in
    let c2 = if (1usize < payloadLen) c1 ^ pkt[5usize] else c1 in
    let c3 = if (2usize < payloadLen) c2 ^ pkt[6usize] else c2 in
    if (3usize < payloadLen) c3 ^ pkt[7usize] else c3;

public definition bool SpecPacketValid(in Span<byte> dst, in Span<byte> pkt)
    requires dst.CanRead && dst.CanWrite && pkt.CanRead
    =>
    if (dst.Length < 8usize || pkt.Length < 4usize || !Span.Disjoint(dst, pkt))
        false
    else if (pkt[0usize] != 0x56u8 || pkt[3usize] != 0x01u8)
        false
    else if (usize.From(pkt[1usize]) > 4usize
        || 4usize + usize.From(pkt[1usize]) > pkt.Length
        || 4usize + usize.From(pkt[1usize]) > dst.Length)
        false
    else
        SpecPacketChecksum(in pkt, pkt[1usize], usize.From(pkt[1usize])) == pkt[2usize];

private Unit CopyPacketToDst(ref Span<byte> dst, in Span<byte> pkt, usize payloadLen)
    effects writes(dst), reads(pkt)
    requires dst.CanRead
    requires dst.CanWrite
    requires pkt.CanRead
    requires dst.Length >= 8usize
    requires pkt.Length >= 4usize
    requires Span.Disjoint(dst, pkt)
    requires payloadLen <= 4usize
    requires 4usize + payloadLen <= pkt.Length
    requires 4usize + payloadLen <= dst.Length
{
    foreach (let i in 0usize..4usize)
        invariant i <= 4usize
        invariant dst.CanRead && dst.CanWrite && dst.Base == old(dst.Base) && dst.Length == old(dst.Length)
        decreases 4usize - i
    {
        dst[i] = pkt[i];
    }
    var payloadView = Span.Slice(dst, 4usize, payloadLen);
    let pktPayload = Span.Slice(pkt, 4usize, payloadLen);
    Span.CopyPrefix(ref payloadView, pktPayload, payloadLen);
}

private u8 ComputePacketChecksum(in Span<byte> pkt, u8 rawLen, usize payloadLen)
    effects reads(pkt)
    requires pkt.CanRead
    requires payloadLen <= 4usize
    requires 4usize + payloadLen <= pkt.Length
{
    var u8 acc = 0x5Au8 ^ rawLen;
    foreach (let i in 0usize..4usize)
        invariant i <= 4usize
        decreases 4usize - i
    {
        if (i < payloadLen)
        {
            acc = acc ^ pkt[4usize + i];
        }
    }
    return acc;
}

public Result<ValidatedPacket<'dst>, ValidationError> PrepareAndValidatePacket<region 'dst>(
    ref<'dst> Span<byte> dst,
    in Span<byte> pkt)
    effects writes(dst), reads(pkt)
    requires dst.CanRead
    requires dst.CanWrite
    requires pkt.CanRead
    ensures match (result)
    {
        Ok(ValidatedPacket(copied, payloadView)) =>
            copied <= 4usize && payloadView.Length == copied && payloadView.CanRead && !payloadView.CanWrite,
        Err(_) =>
            dst.Length == old(dst.Length) && dst.CanRead && dst.CanWrite
    }
    ensures SpecPacketValid(in old(dst), in pkt) <==> (result is Ok(_))
    ensures (result is Ok(_)) ==> (dst[0usize] == pkt[0usize] && dst[1usize] == pkt[1usize] && dst[2usize] == pkt[2usize] && dst[3usize] == pkt[3usize])
{
    if (dst.Length < 8usize || pkt.Length < 4usize || !Span.Disjoint(dst, pkt))
    {
        return Err(FramingShort);
    }
    Span.Fill(ref dst, 0usize, 8usize, 0x00u8);
    let magic = pkt[0usize];
    let rawLen = pkt[1usize];
    let expectedChecksum = pkt[2usize];
    let flags = pkt[3usize];
    let payloadLen = usize.From(rawLen);
    if (magic != 0x56u8 || flags != 0x01u8)
    {
        return Err(BadMagicOrFlags);
    }
    if (payloadLen > 4usize || 4usize + payloadLen > pkt.Length || 4usize + payloadLen > dst.Length)
    {
        return Err(LengthOutOfBounds);
    }
    CopyPacketToDst(ref dst, in pkt, payloadLen);
    let actualChecksum = ComputePacketChecksum(in pkt, rawLen, payloadLen);
    if (actualChecksum != expectedChecksum)
    {
        Span.Fill(ref dst, 0usize, 8usize, 0x00u8);
        return Err(ChecksumRejected);
    }
    let payloadView = Span.ReadOnly(Span.Slice(dst, 4usize, payloadLen));
    return Ok(ValidatedPacket(payloadLen, payloadView));
}

public theorem ValidateEmptyPacketOk(ref Span<byte> dst, in Span<byte> pkt, usize frameIdx)
    requires dst.CanRead && dst.CanWrite && dst.Base <= 0xFFFF_0000usize && dst.Length >= 8usize
    requires pkt.CanRead && pkt.Length >= 4usize
    requires Span.Disjoint(dst, pkt)
    requires pkt[0usize] == 0x56u8 && pkt[1usize] == 0x00u8 && pkt[2usize] == 0x5Au8 && pkt[3usize] == 0x01u8
    requires frameIdx >= 8usize && frameIdx < dst.Length
    ensures (dst.Base == old(dst.Base)
        && dst.Length == old(dst.Length)
        && dst.CanRead
        && dst.CanWrite
        && dst[0usize] == 0x56u8
        && dst[1usize] == 0x00u8
        && dst[2usize] == 0x5Au8
        && dst[3usize] == 0x01u8
        && dst[4usize] == 0x00u8
        && dst[7usize] == 0x00u8
        && dst[frameIdx] == old(dst[frameIdx])) == true
    proof
    {
        let outcome = PrepareAndValidatePacket(ref dst, in pkt);
        assert (SpecPacketValid(in old(dst), in pkt)
            && match (outcome)
            {
                Ok(ValidatedPacket(copied, payloadView)) =>
                    copied == 0usize
                    && payloadView.Base == dst.Base + 4usize
                    && payloadView.Length == 0usize
                    && payloadView.CanRead
                    && !payloadView.CanWrite,
                Err(_) => false
            }) == true;
        assert (dst.Base == old(dst.Base)
            && dst.Length == old(dst.Length)
            && dst.CanRead
            && dst.CanWrite
            && dst[0usize] == 0x56u8
            && dst[1usize] == 0x00u8
            && dst[2usize] == 0x5Au8
            && dst[3usize] == 0x01u8
            && dst[4usize] == 0x00u8
            && dst[7usize] == 0x00u8
            && dst[frameIdx] == old(dst[frameIdx])) == true;
    }

public theorem ValidateFullPacketOk(
    ref Span<byte> dst,
    in Span<byte> pkt,
    byte b0,
    byte b1,
    byte b2,
    byte b3,
    usize frameIdx)
    requires dst.CanRead && dst.CanWrite && dst.Base <= 0xFFFF_0000usize && dst.Length >= 8usize
    requires pkt.CanRead && pkt.Length >= 8usize
    requires Span.Disjoint(dst, pkt)
    requires pkt[0usize] == 0x56u8 && pkt[1usize] == 0x04u8 && pkt[3usize] == 0x01u8
    requires pkt[4usize] == b0 && pkt[5usize] == b1 && pkt[6usize] == b2 && pkt[7usize] == b3
    requires pkt[2usize] == ((0x5Au8 ^ 0x04u8) ^ (b0 ^ b1 ^ b2 ^ b3))
    requires frameIdx >= 8usize && frameIdx < dst.Length
    ensures (dst.Base == old(dst.Base)
        && dst.Length == old(dst.Length)
        && dst[4usize] == b0
        && dst[5usize] == b1
        && dst[6usize] == b2
        && dst[7usize] == b3
        && dst[frameIdx] == old(dst[frameIdx])) == true
    proof
    {
        let outcome = PrepareAndValidatePacket(ref dst, in pkt);
        assert (SpecPacketValid(in old(dst), in pkt)
            && match (outcome)
            {
                Ok(ValidatedPacket(copied, payloadView)) =>
                    copied == 4usize
                    && payloadView.Base == dst.Base + 4usize
                    && payloadView.Length == 4usize
                    && payloadView.CanRead
                    && !payloadView.CanWrite
                    && payloadView[0usize] == b0
                    && payloadView[1usize] == b1
                    && payloadView[2usize] == b2
                    && payloadView[3usize] == b3,
                Err(_) => false
            }) == true;
        assert (dst.Base == old(dst.Base)
            && dst.Length == old(dst.Length)
            && dst[4usize] == b0
            && dst[5usize] == b1
            && dst[6usize] == b2
            && dst[7usize] == b3
            && dst[frameIdx] == old(dst[frameIdx])) == true;
    }

public theorem ValidatePartialPacketScrubsStaleAndTrailingBytes(
    ref Span<byte> dst,
    in Span<byte> pkt,
    byte b0,
    byte b1,
    usize frameIdx)
    requires dst.CanRead && dst.CanWrite && dst.Length >= 8usize
    requires pkt.CanRead && pkt.Length >= 6usize
    requires Span.Disjoint(dst, pkt)
    requires pkt[0usize] == 0x56u8 && pkt[1usize] == 0x02u8 && pkt[3usize] == 0x01u8
    requires pkt[4usize] == b0 && pkt[5usize] == b1
    requires pkt[2usize] == ((0x5Au8 ^ 0x02u8) ^ (b0 ^ b1))
    requires frameIdx >= 8usize && frameIdx < dst.Length
    ensures (dst[4usize] == b0
        && dst[5usize] == b1
        && dst[6usize] == 0x00u8
        && dst[7usize] == 0x00u8
        && dst[frameIdx] == old(dst[frameIdx])) == true
    proof
    {
        let outcome = PrepareAndValidatePacket(ref dst, in pkt);
        assert (SpecPacketValid(in old(dst), in pkt)
            && match (outcome)
            {
                Ok(ValidatedPacket(copied, payloadView)) =>
                    copied == 2usize
                    && payloadView.Length == 2usize
                    && payloadView.CanRead
                    && !payloadView.CanWrite
                    && payloadView[0usize] == b0
                    && payloadView[1usize] == b1,
                Err(_) => false
            }) == true;
        assert (dst[4usize] == b0
            && dst[5usize] == b1
            && dst[6usize] == 0x00u8
            && dst[7usize] == 0x00u8
            && dst[frameIdx] == old(dst[frameIdx])) == true;
    }

public theorem RejectFramingShort(ref Span<byte> dst, in Span<byte> pkt, usize idx)
    requires dst.CanRead && dst.CanWrite
    requires pkt.CanRead && pkt.Length < 4usize
    requires idx < dst.Length
    ensures (dst.Base == old(dst.Base)
        && dst.Length == old(dst.Length)
        && dst.CanWrite
        && dst[idx] == old(dst[idx])) == true
    proof
    {
        let outcome = PrepareAndValidatePacket(ref dst, in pkt);
        assert (!SpecPacketValid(in old(dst), in pkt)
            && (outcome is Err(FramingShort))) == true;
        assert (dst.Base == old(dst.Base)
            && dst.Length == old(dst.Length)
            && dst.CanWrite
            && dst[idx] == old(dst[idx])) == true;
    }

public theorem RejectBadMagic(ref Span<byte> dst, in Span<byte> pkt, usize frameIdx)
    requires dst.CanRead && dst.CanWrite && dst.Length >= 8usize
    requires pkt.CanRead && pkt.Length >= 4usize
    requires Span.Disjoint(dst, pkt)
    requires pkt[0usize] != 0x56u8
    requires frameIdx >= 8usize && frameIdx < dst.Length
    ensures (dst[0usize] == 0x00u8
        && dst[7usize] == 0x00u8
        && dst[frameIdx] == old(dst[frameIdx])) == true
    proof
    {
        let outcome = PrepareAndValidatePacket(ref dst, in pkt);
        assert (!SpecPacketValid(in old(dst), in pkt)
            && (outcome is Err(BadMagicOrFlags))) == true;
        assert (dst[0usize] == 0x00u8
            && dst[7usize] == 0x00u8
            && dst[frameIdx] == old(dst[frameIdx])) == true;
    }

public theorem RejectLengthOutOfBounds(ref Span<byte> dst, in Span<byte> pkt, usize frameIdx)
    requires dst.CanRead && dst.CanWrite && dst.Length >= 8usize
    requires pkt.CanRead && pkt.Length >= 4usize
    requires Span.Disjoint(dst, pkt)
    requires pkt[0usize] == 0x56u8 && pkt[3usize] == 0x01u8 && pkt[1usize] > 0x04u8
    requires frameIdx >= 8usize && frameIdx < dst.Length
    ensures (dst.Length == old(dst.Length)
        && dst[0usize] == 0x00u8
        && dst[7usize] == 0x00u8
        && dst[frameIdx] == old(dst[frameIdx])) == true
    proof
    {
        let outcome = PrepareAndValidatePacket(ref dst, in pkt);
        assert (!SpecPacketValid(in old(dst), in pkt)
            && (outcome is Err(LengthOutOfBounds))) == true;
        assert (dst.Length == old(dst.Length)
            && dst[0usize] == 0x00u8
            && dst[7usize] == 0x00u8
            && dst[frameIdx] == old(dst[frameIdx])) == true;
    }

public theorem RejectChecksumScrubsDestinationAndRestores(
    ref Span<byte> dst,
    in Span<byte> pkt,
    byte b0,
    byte b1,
    usize frameIdx)
    requires dst.CanRead && dst.CanWrite && dst.Length >= 8usize
    requires pkt.CanRead && pkt.Length >= 6usize
    requires Span.Disjoint(dst, pkt)
    requires pkt[0usize] == 0x56u8 && pkt[1usize] == 0x02u8 && pkt[3usize] == 0x01u8
    requires pkt[4usize] == b0 && pkt[5usize] == b1
    requires pkt[2usize] != ((0x5Au8 ^ 0x02u8) ^ (b0 ^ b1))
    requires frameIdx >= 8usize && frameIdx < dst.Length
    ensures (dst.Base == old(dst.Base)
        && dst.Length == old(dst.Length)
        && dst.CanWrite
        && dst[0usize] == 0x00u8
        && dst[4usize] == 0x00u8
        && dst[5usize] == 0x00u8
        && dst[7usize] == 0x00u8
        && dst[frameIdx] == old(dst[frameIdx])) == true
    proof
    {
        let outcome = PrepareAndValidatePacket(ref dst, in pkt);
        assert (!SpecPacketValid(in old(dst), in pkt)
            && (outcome is Err(ChecksumRejected))) == true;
        assert (dst.Base == old(dst.Base)
            && dst.Length == old(dst.Length)
            && dst.CanWrite
            && dst[0usize] == 0x00u8
            && dst[4usize] == 0x00u8
            && dst[5usize] == 0x00u8
            && dst[7usize] == 0x00u8
            && dst[frameIdx] == old(dst[frameIdx])) == true;
    }
