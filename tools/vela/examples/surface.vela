// Syntax-only development example: no elaboration or proof claim.
module Vela.Surface;

public const usize FirstOffset = 0usize;

public const Nat Square(Nat value) => value * value;
public Nat Scale(const Nat factor, Nat value)
{
    const Nat multiplier = Square(factor);
    return multiplier * value;
}

public record Packet<region 'source>(
    usize Length,
    in<'source> Span<byte> Data,
    ghost Nat Count)
    invariant Nat(Length) == Count
{
    public bool IsEmpty => this.Length == 0usize;
    public ghost Seq<byte> Model => this.Data.Model;
}

public Packet<'source> ResizePacket<region 'source>(
    owned Packet<'source> packet, usize length, ghost Nat count)
    requires Nat(length) == count
    => move packet with { Length = length, Count = count };

public union Delivery<ghost Nat n>
{
    Accepted(owned Packet<n> packet, tracked Permit<n> receipt);
    Cancelled(owned Packet<n> packet);
}

public void Fill<ghost Nat count>(ref Span<byte, count> target, byte value)
    effects writes(target)
    ensures target.Model.All(x => x == value)
{
    foreach (let index in 0..target.Length)
        invariant target.Model.Take(Nat(index)).All(x => x == value)
    {
        target[index] = value;
        proof
        {
            assert target[index] == value by ExtendAll(target, index, value);
            assert target.Model.Take(Nat(index)).All(x => x == value) by
            {
                assert target[index] == value;
            }
            ?extend;
        }
    }
}

// Collection loops preserve explicit value and element-loan modes.
public void Visit(ref Span<byte> target, in Span<byte> source)
    where ISequenceModel(source) && IBoundedIterable(target)
    requires source.Model.All(x => x > 0)
    requires source.Model.Any(x => x == 1) && source.Model.Contains(1)
    ensures target.Model.Take(1).Skip(0).Slice(0, 1).Count <= target.Model.Count
    effects reads(source), writes(target)
{
    foreach (let byte value in source)
        invariant source.Model.All(x => x > 0)
    {
        let byte observed = value;
        Inspect(observed);
        continue;
    }
    foreach (in item in source)
        invariant source.Model.Contains(1)
    {
        Inspect(in item);
        break;
    }
    foreach (ref byte item in target)
        invariant target.Model.Count == old(target.Model.Count)
    {
        Update(ref item);
    }
}

// Raw string literals and buffer-writing format templates avoid heap allocation.
public const Span<byte> HeaderBanner = """
    VELA-PACKET "v1" \raw
    """;

public Result<usize, CapacityError> FormatPacketHeader<ghost Nat capacity>(
    ref TextBuilder<capacity> builder, usize packetId, byte tag)
    where Format(usize) && Format(byte)
    effects writes(builder)
{
    let bannerBytes = Format.Write(ref builder, $"header={{")?;
    let bodyBytes = Format.Write(ref builder, $"id={packetId},tag={tag:x2}}}")?;
    return Ok(bannerBytes + bodyBytes);
}

public effect Choose
{
    bool Choose() resumes(0..2);
}

public async Delivery<n> Accept<ghost Nat n>(
    owned Packet<n> packet, tracked Permit<n> allowance)
    effects reads(packet), calls(Forward, Counter.Add)
{
    await Forward(in packet);
    let receipt = commit Counter.Add(move allowance, packet.Length);
    return Accepted(packet: move packet, receipt: receipt);
}
on cancel
{
    return Cancelled(packet: move packet);
}

// A callable's parameter telescope also binds its result indices and use grades.
public alias Build<captures C, grade q : NatExact> =
    Fn(usize length, byte seed @ q) -> Buffer<byte, length> captures C;

// Dependent records package represented data with erased evidence.
// No separate packet, box, cell or protocol-token primitive is needed.
public record Sized<T>(
    usize Length,
    owned Buffer<T, Length> Storage,
    ghost Bounded<Length> Evidence);

public record Box<T, grade q : NatExact>(T Value @ q);

public union Initialization<ghost Nat n>
{
    Ready(owned Buffer<byte, n, Initialized> buffer, tracked Closed receipt);
    Rejected(owned Buffer<byte, n, Uninitialized> buffer, tracked Closed receipt);
}

public Initialization<n> Prepare<ghost Nat n>(
    owned Buffer<byte, n, Uninitialized> storage, tracked Open obligation)
{
    let buffer = Initialize(move storage);
    let receipt = Finish(move obligation);
    return Ready(buffer: move buffer, receipt: move receipt);
}

// Products carry several resources through the same construction/elimination forms.
public (owned Packet<n>, tracked Permit<n>) Pair<ghost Nat n>(
    owned Packet<n> packet, tracked Permit<n> permit)
{
    return (move packet, move permit);
}

public Unit ForwardPair<ghost Nat n>((owned Packet<n>, tracked Permit<n>) pair)
{
    let (packet, permit) = pair;
    Forward(in packet);
    Release(move permit);
    Dispose(move packet);
    return ();
}

// Higher-order libraries accept the same operator values as grade dictionaries.
public definition Nat SumValues(Seq<Nat> values) => Fold((+), 0, values);

// Constructor elimination reuses the patterns of matches and pattern tests.
public Unit ConsumeReady<ghost Nat n>(Initialization<n> outcome)
    requires outcome is Ready(buffer: _, receipt: _)
{
    let Ready(buffer: buffer, receipt: receipt) = outcome;
    Consume(move buffer);
    Release(move receipt);
    return ();
}

// Returned loans state the obligation that holds when the loan ends.
public Result<ref<'workspace.bytes> byte, Error> First(ref Workspace workspace)
    requires workspace.bytes.Length > 0
    effects writes(workspace.bytes)
    restores result is Ok(slot) ==>
        workspace.bytes.Model == old(workspace.bytes.Model).Update(0, final(slot))
{
    let ref Span<byte> parent = ref workspace.bytes;
    let ref byte child = ref parent[FirstOffset];
    return Ok(child);
}

// The library brackets guards; the caller examines every represented outcome.
public Result<Unit, BorrowError> ReplaceByte(ref BorrowCell<byte> cell, byte value)
{
    let outcome = cell.WithTryWrite((scoped ref byte selected @ NatExact(1)) =>
    {
        selected = value;
        return ();
    });
    match (outcome)
    {
        Updated(()) => return Ok(());
        BorrowConflict => return Err(Conflict);
        CapacityExhausted => return Err(Capacity);
    }
}

// Eligibility remains an explicit library contract with a proof obligation.
public (Box<T, q>, Box<T, q>) Duplicate<T, grade q : NatExact>(owned Box<T, q> value)
    where Dup(value)
    ensures Split(old(value), result);

public void Close<T>(owned T value) where Dispose(value);

public async T Preserve<T>(owned T value)
    where Suspend(value)
    ensures Preserved(old(value), result)
{
    await Checkpoint();
    return move value;
}
on cancel
{
    Close(move value);
}

// The same grades and generic contracts describe ordinary library instances.
public struct Graded<T, grade q : NatExact>
{
    private T Value @ q;
}

public impl<T, grade q : NatExact> Duplicate<Graded<T, q>>
    where Repeatable(T, q)
{
    public (owned Graded<T, q>, owned Graded<T, q>) Split(owned Graded<T, q> value)
        ensures Preserved(old(value), result);
}

// The callback binds its own region; its restoration belongs to the callable.
public alias ScopedUpdate<T, captures C> =
    Fn<region 'loan>(scoped ref<'loan> T value) -> Unit captures C
        with
        {
            requires Valid(value);
            restores Valid(value);
        };

// A dependent match names its scrutinee in the result type before eliminating it.
public definition owned Buffer<T, packet.Length> TakeStorage<T>(owned Sized<T> packet) =>
    match (packet) as whole : owned Buffer<T, whole.Length>
    {
        Sized(length, storage, evidence) => move storage,
    };

public Result<ref<'workspace.bytes> byte, Error> ForwardSlot(ref Workspace workspace)
    effects writes(workspace.bytes)
    restores result is Ok(slot) ==>
        workspace.bytes.Model == old(workspace.bytes.Model).Update(0, final(slot))
{
    return match (workspace.TryFirst())
    {
        Ok(slot) => Ok(slot),
        Err(error) => Err(error),
    };
}

// Resource contracts use the same forms on containers and effect operations.
public interface LoanStorage<T> where StorageLaws(T)
{
    ref<'input> T First(ref Span<T> input)
        requires input.Length > 0
        restores Preserved(input, final(result));
}

public struct Stored<T, grade q : NatExact>
    where Admits(T, q)
    invariant Closed(this)
{
    private T Value @ q;
    public void Release() requires Disposable(this) ensures Disposed(this);
}

// Selective invariant lifting opens only the named clauses during multi-step updates;
// two-step bulk relocation separates byte/capability copy from linear type transfer.
public struct BoundedBuffer<T, ghost Nat capacity>
    invariant LengthBound: Nat(this.length) <= capacity
    invariant InitializedPrefix: LivePrefix(this.slots, 0usize, this.length)
    invariant VacantSuffix: VacantRange(this.slots, this.length, capacity)
{
    private usize length;
    private Slots<T, capacity> slots;
    public ghost Seq<T> Model => PrefixModel(this.slots, this.length);

    public void RelocateInto<ghost Nat targetCapacity>(
        ref BoundedBuffer<T, targetCapacity> destination)
        requires capacity <= targetCapacity && destination.length == 0usize
        effects writes(this), writes(destination)
        ensures destination.Model == old(this.Model) && this.length == 0usize
    {
        open (ref this, ref destination) lifts InitializedPrefix, VacantSuffix
        {
            CopyRepresentation(
                source: in this.slots,
                destination: ref destination.slots,
                count: this.length);
            TransferType<T>(
                source: ref this.slots,
                destination: ref destination.slots,
                count: this.length);
            destination.length = this.length;
            this.length = 0usize;
        }
    }
}

public effect Exchange<T> where Representable(T) invariant Closed(Storage)
{
    owned T Replace(owned T replacement @ NatExact(1)) resumes(0..1)
        requires Available(replacement)
        ensures Returned(result)
        restores Closed(result)
        effects writes(Storage);
}

// A clause can explicitly forward through an outer capability using an ordinary call.
public Nat ForwardChoice()
{
    return handle (handle (inner.Choose()) as inner
    {
        Choose() with k => resume k(outer.Choose()),
        return value => value,
    }) as outer
    {
        Choose() with k => resume k(1),
        return value => value,
    };
}

// Type families and resource libraries reuse ordinary definitions and contracts.
universe u;
public definition Type<u> RepeatedType<T : Type<u>>(bool repeated)
    where Repeatable(T)
    => match (repeated) as choice : Type<u>
    {
        true => type (T, T),
        false => type T,
    };

// Type-valued library functions can supply types throughout the same surface.
public alias Repeated<T : Type<u>, ghost bool repeated>
    where Repeatable(T)
    = type[RepeatedType<T>(repeated)];

public type[RepeatedType<T>(repeated)] Repeat<T : Type<u>>(
    bool repeated, T value @ NatExact(1))
    where Repeatable(T);

public void UseRepeated<T : Type<u>>(bool repeated, T source)
    where Repeatable(T)
{
    let type[RepeatedType<T>(repeated)] selected @ NatExact(1) = Repeat(repeated, source);
    let identity = (type[RepeatedType<T>(repeated)] value @ NatExact(1)) => value;
    let Box<type[RepeatedType<T>(repeated)], (NatExact(1))> boxed = Box(identity(selected));
    Consume(move boxed);
}

// Empty sums use the ordinary dependent eliminator, without an abort primitive.
public inductive Never
{
}
public definition T Absurd<T>(Never impossible) =>
    match (impossible) as whole : T
    {
    };

// Literal discrimination composes with the same indexed-result match syntax.
public definition Nat ClassifyCharacter(char value) => match (value)
{
    'a' => 1,
    '\n' => 2,
    _ => 0,
};

public interface ResourceFamily<T : Type<u>> where Representable(T)
{
    type Output : Type<u> where Formed(T);
    predicate Ready(T value) requires Stable(value);
}

public union ResourceOutcome<T : Type<u>> where Representable(T)
{
    Returned(owned T value @ NatExact(1)) ensures Retained(result);
    Unavailable(tracked Closed receipt) restores Closed(receipt);
}

// A value can state the same local loan telescope and laws as a callable type.
public void UpdateCell<T : Type<u>>(ref LocalCell<T> cell)
{
    let update = FnMut<region 'loan>(scoped ref<'loan> T value @ NatExact(1)) -> Unit
        effects(Write)
        with
        {
            requires Open(value);
            restores Closed(final(value));
        }
        =>
        {
            Touch(ref value);
            return ();
        };
    cell.WithWrite(update);
}

// Product grades are ordinary dictionary applications over pair values.
// Compatible supplies the interaction laws; syntax establishes none of them.
public domain Product<A : GradeDomain, B : GradeDomain>
    where Compatible(A, B)
{
    carrier (A.carrier, B.carrier);
    zero (A.zero, B.zero);
    one (A.one, B.one);
    add Products.Combine(A.add, B.add);
    mul Products.Combine(A.mul, B.mul);
    admits Products.All(A.admits, B.admits);
    interpret Products.Interpret(A.interpret, B.interpret);
    laws Products.Laws(A.laws, B.laws);
}

// Local allowances reuse parameter grades, independently of the loan's authority.
public Nat ReadAndApply(
    ref Span<byte> bytes, owned Box<FnOnce(Nat) -> Nat> callback)
    requires bytes.Length > 0
    restores Valid(bytes)
{
    let ghost Nat length @ NatExact(0) = Nat(bytes.Length);
    let ref<'bytes> byte first @ NatExact(1) = ref bytes[0usize];
    let Box<FnOnce(Nat) -> Nat> retained @ NatExact(1) = move callback;
    let observed @ NatExact(1) = Read(in first);
    return retained.Value(observed);
}

// Unary continuation disposal and a handler's disposal graph have distinct roles.
// The graph takes a reason; capture and ordinary return do not invoke it.
public Result<Nat, Error> ReadGuarded(owned Guard resource)
{
    return handle (ReadOrFail(in resource)) as running
    {
        Fail(error) with k =>
        {
            dispose k;
            return Err(error);
        },
        return value => Ok(value),
        dispose reason =>
        {
            resource.Release(reason);
            return ();
        },
    };
}

// Short functions keep the same contracts, ownership and evaluation rules.
public Nat Increment(Nat value,)
    requires value < 10
    ensures result == value + 1
    => value + 1;

public Nat ClampIncrement(Nat value, Nat limit)
    => if (value < limit) value + 1 else limit;

public Result<ref<'workspace.bytes> byte, Error> UnwrapSlot(ref Workspace workspace)
    effects writes(workspace.bytes)
{
    let Ok(slot) = workspace.TryFirst() else
    {
        return Err(Empty);
    }
    return if (workspace.TryFirst() is Ok(following)) Ok(following) else Ok(slot);
}

public Fn(Nat) -> Nat Incrementer() => value => value + 1;
