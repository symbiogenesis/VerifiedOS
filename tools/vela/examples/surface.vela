// Syntax-only development example: no elaboration or proof claim.
module Vela.Surface;

public record Packet<region 'source>(
    usize Length,
    in<'source> Span<byte> Data,
    ghost Nat Count)
    invariant Nat(Length) == Count;

public union Delivery<ghost Nat n> {
    Accepted(owned Packet<n> packet, tracked Permit<n> receipt);
    Cancelled(owned Packet<n> packet);
}

public void Fill<ghost Nat count>(ref Span<byte, count> target, byte value)
    effects writes(target)
    ensures target.Model == Seq.Repeat(value, count)
{
    for (let index in 0usize..target.Length)
        invariant target.Model.Take(Nat(index)) == Seq.Repeat(value, Nat(index))
    {
        target[index] = value;
        proof { ?extend; }
    }
}

public effect Choose {
    bool Choose() resumes(0..2);
}

public async Delivery<n> Accept<ghost Nat n>(
    owned Packet<n> packet, tracked Permit<n> allowance)
    effects reads(packet), calls(Forward, Counter.Add)
{
    await Forward(in packet);
    let receipt = commit Counter.Add(move allowance, packet.Length);
    return Accepted(move packet, receipt);
}
on cancel {
    return Cancelled(move packet);
}

// A callable's parameter telescope also binds its result indices and use grades.
public alias Build<captures C, grade q : NatExact> =
    Fn(usize length, byte seed @ q) -> Buffer<byte, length> captures C;

// Dependent records package represented data with erased evidence.
// No separate packet, box, cell or protocol-token primitive is needed.
public record Sized<T>(
    usize Length,
    owned Buffer<T, Length> Storage,
    ghost Bounded<Length> Evidence);

public record Box<T, grade q : NatExact>(T Value @ q);

public union Initialization<ghost Nat n> {
    Ready(owned Buffer<byte, n, Initialized> buffer, tracked Closed receipt);
    Rejected(owned Buffer<byte, n, Uninitialized> buffer, tracked Closed receipt);
}

public Initialization<n> Prepare<ghost Nat n>(
    owned Buffer<byte, n, Uninitialized> storage, tracked Open obligation)
{
    let buffer = Initialize(move storage);
    let receipt = Finish(move obligation);
    return Ready(move buffer, move receipt);
}

// Products carry several resources through the same construction/elimination forms.
public (owned Packet<n>, tracked Permit<n>) Pair<ghost Nat n>(
    owned Packet<n> packet, tracked Permit<n> permit)
{
    return (move packet, move permit);
}

public () ForwardPair<ghost Nat n>((owned Packet<n>, tracked Permit<n>) pair) {
    let (let packet, let permit) = pair;
    Forward(in packet);
    Release(move permit);
    Dispose(move packet);
    return ();
}

// Returned loans state the obligation that holds when the loan ends.
public Result<ref<'workspace.bytes> byte, Error> First(ref Workspace workspace)
    requires workspace.bytes.Length > 0
    effects writes(workspace.bytes)
    restores result is Ok(let slot) ==>
        workspace.bytes.Model == old(workspace.bytes.Model).Set(0, final(slot))
{
    ref Span<byte> parent = ref workspace.bytes;
    ref byte child = ref parent[0usize];
    return Ok(child);
}

// The library brackets guards; the caller examines every represented outcome.
public Result<type (), BorrowError> ReplaceByte(ref BorrowCell<byte> cell, byte value) {
    let outcome = cell.WithTryWrite((scoped ref byte selected @ NatExact(1)) => {
        selected = value;
        return ();
    });
    match (outcome) {
        case Updated(()): return Ok(());
        case BorrowConflict: return Err(Conflict);
        case CapacityExhausted: return Err(Capacity);
    }
}

// Eligibility remains an explicit library contract with a proof obligation.
public (Box<T, q>, Box<T, q>) Duplicate<T, grade q : NatExact>(owned Box<T, q> value)
    where Dup(value)
    ensures Split(old(value), result);

public void Close<T>(owned T value) where Dispose(value);

public async T Preserve<T>(owned T value)
    where Suspend(value)
    ensures Preserved(old(value), result)
{
    await Checkpoint();
    return move value;
}
on cancel { Close(move value); }

// The same grades and generic contracts describe ordinary library instances.
public struct Graded<T, grade q : NatExact> {
    private T Value @ q;
}

public impl<T, grade q : NatExact> Duplicate<Graded<T, q>>
    where Repeatable(T, q)
{
    public (owned Graded<T, q>, owned Graded<T, q>) Split(owned Graded<T, q> value)
        ensures Preserved(old(value), result);
}

// The callback binds its own region; its restoration belongs to the callable.
public alias ScopedUpdate<T, captures C> =
    Fn<region 'loan>(scoped ref<'loan> T value) -> () captures C
        with { requires Valid(value); restores Valid(value); };

// A dependent match names its scrutinee in the result type before eliminating it.
public definition owned Buffer<T, packet.Length> TakeStorage<T>(owned Sized<T> packet) =
    match (packet) as whole : owned Buffer<T, whole.Length> {
        case Sized(let length, let storage, let evidence) => move storage;
    };

public Result<ref<'workspace.bytes> byte, Error> ForwardSlot(ref Workspace workspace)
    effects writes(workspace.bytes)
    restores result is Ok(let slot) ==>
        workspace.bytes.Model == old(workspace.bytes.Model).Set(0, final(slot))
{
    return match (workspace.TryFirst()) {
        case Ok(let slot) => Ok(slot);
        case Err(let error) => Err(error);
    };
}

// Resource contracts use the same forms on containers and effect operations.
public interface LoanStorage<T> where StorageLaws(T) {
    operation ref<'input> T First(ref Span<T> input)
        requires input.Length > 0
        restores Preserved(input, final(result));
}

public struct Stored<T, grade q : NatExact>
    where Admits(T, q)
    invariant Closed(self)
{
    private T Value @ q;
    public void Release() requires Disposable(self) ensures Disposed(self);
}

public effect Exchange<T> {
    owned T Replace(owned T replacement @ NatExact(1)) resumes(0..1)
        requires Available(replacement)
        ensures Returned(result)
        restores Closed(result)
        effects writes(Storage);
}

// A clause can explicitly forward through an outer capability using an ordinary call.
public Nat ForwardChoice() {
    return handle (handle (inner.Choose()) as inner {
        Choose() with k => resume k(outer.Choose()),
        return value => value,
    }) as outer {
        Choose() with k => resume k(1),
        return value => value,
    };
}
