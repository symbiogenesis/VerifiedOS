// Mathematical development prototype; kernel replay checks emitted terms.
module Dependent;

public definition TValue Identity<TValue>(TValue value) => value;

public const Nat Limit = Identity(value: 1);

public const Nat Square(Nat value) => value * value;
public Nat Scale(const Nat factor, Nat value)
{
    const Nat multiplier = Square(factor);
    return multiplier * value;
}
public Nat Process(Nat value) => Scale(factor: Limit, value: value);

public definition TResult Apply<TInput, TResult>(Fn(TInput value) -> TResult function, TInput value) =>
    function(value: value);

public definition (Nat, bool) SeparateInstantiations() =>
    (Identity(7), Identity<bool>(true));

public definition Nat FirstComponent() => Fst(SeparateInstantiations());

public definition bool SecondComponent() => Snd(SeparateInstantiations());

public definition (TRight, TLeft) SwapPair<TLeft, TRight>((TLeft, TRight) pair) =>
    let (left, right) = pair in (right, left);

public definition Nat Predecessor(Nat value) =>
    match (value) {
        0 => 0,
        Succ(previous) => previous,
    };

public lemma PredecessorSuccessor(Nat value): Predecessor(Succ(value)) == value
    proof
    {
        assert Predecessor(Succ(value)) == value;
    }

public definition bool Flip(bool flag) =>
    match (flag) {
        true => false,
        false => true,
    };

public lemma DoubleNegation(bool flag): Flip(Flip(flag)) == flag
    proof
    {
        match (flag)
        {
            case true:
                assert Flip(Flip(true)) == true;
            case false:
                assert Flip(Flip(false)) == false;
        }
    }

public definition Nat HigherOrder() =>
    Apply(function: value => value + 1, value: 41,);

public definition Vec<TElement, length> Copy<TElement, ghost Nat length>(Vec<TElement, length> values) => values;

public alias Words<ghost Nat length> = Vec<Nat, length>;

public definition Vec<Nat, Limit> Singleton() => VCons(42, VNil<Nat>());

public definition Words<1> Aliased() => Singleton();

public definition Nat Lookup() => At(Copy(values: Singleton()), FZero<0>());

public lemma LookupValue(): Lookup() == 42
    proof
    {
        assert Lookup() == 42;
    }

public definition Fn(Nat length, Vec<Nat, length> values) -> Vec<Nat, length> PreserveLength() =>
    (Nat length, Vec<Nat, length> values) => values;

public definition Vec<Nat, Limit> PreservedSingleton() =>
    PreserveLength()(length: Limit, values: Singleton());

public lemma Reflexivity<TValue>(TValue value): value == value
    proof
    {
        assert value == value;
    }

public lemma Composed(Nat value): value == value
    proof
    {
        assert value == value by
        {
            let step = Identity(value);
            assert value == step;
            assert step == value;
        }
    }

public lemma Congruence(Nat value): value + 1 == value + 1
    proof
    {
        assert value + 1 == value + 1 by Reflexivity(value);
    }

public definition type[Eq<Nat>(value, value)] KeepEvidence(
    Nat value, type[Eq<Nat>(value, value)] evidence) => evidence;

public definition TProposition KeepProof<TProposition : Prop>(TProposition evidence) => evidence;

public lemma ForwardProof<TProposition : Prop>(TProposition evidence): TProposition
    proof
    {
        assert TProposition by KeepProof(evidence);
    }

public definition Type<1> SmallUniverse() => type Type;
