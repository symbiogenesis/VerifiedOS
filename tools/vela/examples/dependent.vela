// Mathematical development prototype; kernel replay checks emitted terms.
module Dependent;

public definition TValue Identity<TValue>(TValue value) => value;

public const Nat Limit = Identity(value: 1);

public const Nat Square(Nat value) => value * value;
public Nat Scale(const Nat factor, Nat value)
{
    const Nat multiplier = Square(factor);
    return multiplier * value;
}
public Nat Process(Nat value) => Scale(factor: Limit, value: value);

public definition TResult Apply<TInput, TResult>(Fn(TInput value) -> TResult function, TInput value) =>
    function(value: value);

public definition (Nat, bool) SeparateInstantiations() =>
    (Identity(7), Identity<bool>(true));

public definition Nat FirstComponent() => Fst(SeparateInstantiations());

public definition bool SecondComponent() => Snd(SeparateInstantiations());

public definition (TRight, TLeft) SwapPair<TLeft, TRight>((TLeft, TRight) pair) =>
    let (left, right) = pair in (right, left);

public definition Nat Predecessor(Nat value) =>
    match (value) {
        0 => 0,
        Succ(previous) => previous,
    };

public lemma PredecessorSuccessor(Nat value): Predecessor(Succ(value)) == value
    proof
    {
        assert Predecessor(Succ(value)) == value;
    }

public definition bool Flip(bool flag) =>
    match (flag) {
        true => false,
        false => true,
    };

public lemma DoubleNegation(bool flag): Flip(Flip(flag)) == flag
    proof
    {
        match (flag)
        {
            case true:
                assert Flip(Flip(true)) == true;
            case false:
                assert Flip(Flip(false)) == false;
        }
    }

public definition Nat HigherOrder() =>
    Apply(function: value => value + 1, value: 41,);

public definition Vec<TElement, length> Copy<TElement, ghost Nat length>(Vec<TElement, length> values) => values;

public alias Words<ghost Nat length> = Vec<Nat, length>;

public definition Vec<Nat, Limit> Singleton() => VCons(42, VNil<Nat>());

public definition Words<1> Aliased() => Singleton();

public definition Nat Lookup() => At(Copy(values: Singleton()), FZero<0>());

public lemma LookupValue(): Lookup() == 42
    proof
    {
        assert Lookup() == 42;
    }

public definition Fn(Nat length, Vec<Nat, length> values) -> Vec<Nat, length> PreserveLength() =>
    (Nat length, Vec<Nat, length> values) => values;

public definition Vec<Nat, Limit> PreservedSingleton() =>
    PreserveLength()(length: Limit, values: Singleton());

public lemma Reflexivity<TValue>(TValue value): value == value
    proof
    {
        assert value == value;
    }

public lemma Composed(Nat value): value == value
    proof
    {
        assert value == value by
        {
            let step = Identity(value);
            assert value == step;
            assert step == value;
        }
    }

public lemma Congruence(Nat value): value + 1 == value + 1
    proof
    {
        assert value + 1 == value + 1 by Reflexivity(value);
    }

public definition type[Eq<Nat>(value, value)] KeepEvidence(
    Nat value, type[Eq<Nat>(value, value)] evidence) => evidence;

public definition TProposition KeepProof<TProposition : Prop>(TProposition evidence) => evidence;

public lemma ForwardProof<TProposition : Prop>(TProposition evidence): TProposition
    proof
    {
        assert TProposition by KeepProof(evidence);
    }

public record Counter(Nat Value, Nat Limit)
{
    public bool AtLimit => this.Value >= this.Limit;
    public Nat Remaining => this.Limit - this.Value;
}

public Nat DefaultStep => Limit;

public definition Counter AdvanceCounter(Counter counter, Nat step) =>
    if (counter.AtLimit) counter
    else counter with { Value = counter.Value + step };

public definition Nat UnpackCounter(Counter counter) =>
    match (counter) {
        Counter(Value: current, Limit: maximum) =>
            if (current <= maximum) maximum - current else 0,
    };

public Nat StepIfPositive(Nat value, Counter counter)
{
    let Succ(previous) = value else
    {
        return counter.Value;
    }
    let Counter(Value: base, Limit: limit) = counter;
    return if (previous is Succ(inner)) base + inner + limit else base + limit;
}

public lemma AdvanceBelowLimit():
    AdvanceCounter(Counter(Value: 2, Limit: 5), DefaultStep).Value == 3
    proof
    {
        assert AdvanceCounter(Counter(Value: 2, Limit: 5), DefaultStep).Value == 3;
    }

public lemma CounterPropertyAgreement():
    Counter(Value: 2, Limit: 5).Remaining == UnpackCounter(Counter(Value: 2, Limit: 5))
    proof
    {
        assert Counter(Value: 2, Limit: 5).Remaining == UnpackCounter(Counter(Value: 2, Limit: 5));
    }

public lemma StepIfPositiveProof():
    StepIfPositive(2, Counter(Value: 10, Limit: 5)) == 15
    proof
    {
        assert StepIfPositive(2, Counter(Value: 10, Limit: 5)) == 15;
    }

public union Option<TValue>
{
    None();
    Some(TValue Value);
}

public definition TValue UnwrapOr<TValue>(Option<TValue> item, TValue fallback) =>
    match (item) {
        None() => fallback,
        Some(Value: inner) => inner,
    };

public lemma UnwrapSome(Nat value, Nat fallback):
    UnwrapOr(Some(Value: value), fallback) == value
    proof
    {
        assert UnwrapOr(Some(Value: value), fallback) == value;
    }

public lemma OptionRoundTrip(Option<Nat> item):
    (match (item) {
        None() => None<Nat>(),
        Some(value) => Some<Nat>(value),
    }) == item
    proof
    {
        match (item)
        {
            case None():
                assert (match (None<Nat>()) {
                    None() => None<Nat>(),
                    Some(value) => Some<Nat>(value),
                }) == None<Nat>();
            case Some(value):
                assert (match (Some<Nat>(value)) {
                    None() => None<Nat>(),
                    Some(inner) => Some<Nat>(inner),
                }) == Some<Nat>(value);
        }
    }

public definition Option<Nat> AddOptions(Option<Nat> left, Option<Nat> right) =>
    Some(left? + right?);

public lemma PropagateSome(): AddOptions(Some(3), Some(4)) == Some(7)
    proof
    {
        assert AddOptions(Some(3), Some(4)) == Some(7);
    }

public lemma PropagateNone(): AddOptions(None<Nat>(), Some(4)) == None<Nat>()
    proof
    {
        assert AddOptions(None<Nat>(), Some(4)) == None<Nat>();
    }

public definition Nat AddRec(Nat left, Nat right) decreases left =>
    match (left) {
        0 => right,
        Succ(previous) => Succ(AddRec(previous, right)),
    };

public lemma AddZeroRight(Nat value): value + 0 == value
    proof
    {
        match (value)
        {
            case 0:
                assert 0 + 0 == 0;
            case Succ(previous):
                assert Succ(previous) + 0 == Succ(previous) by AddZeroRight(previous);
        }
    }

public lemma AddSuccRight(Nat left, Nat right): left + Succ(right) == Succ(left + right)
    proof
    {
        match (left)
        {
            case 0:
                assert 0 + Succ(right) == Succ(0 + right);
            case Succ(previous):
                assert Succ(previous) + Succ(right) == Succ(Succ(previous) + right) by AddSuccRight(previous, right);
        }
    }

public theorem AddComm(Nat left, Nat right): left + right == right + left
    proof
    {
        match (left)
        {
            case 0:
                assert 0 + right == right + 0 by AddZeroRight(right);
            case Succ(previous):
                assert Succ(previous) + right == right + Succ(previous) by
                {
                    assert Succ(previous + right) == Succ(right + previous) by AddComm(previous, right);
                    assert right + Succ(previous) == Succ(right + previous) by AddSuccRight(right, previous);
                }
        }
    }

public record BoundedIndex(Nat Limit, Fin<Limit> Index)
{
    public Nat Capacity => this.Limit;
}

public definition BoundedIndex ZeroBoundedIndex() =>
    BoundedIndex(Limit: 1, Index: FZero<0>());

public lemma ZeroBoundedCapacity(): ZeroBoundedIndex().Capacity == 1
    proof
    {
        assert ZeroBoundedIndex().Capacity == 1;
    }

public lemma ExistsRightIdentity(Nat value): exists (Nat neutral) => value + neutral == value
    proof
    {
        assert exists (Nat neutral) => value + neutral == value by
        {
            assert value + 0 == value by AddZeroRight(value);
        }
    }

public definition Type<1> SmallUniverse() => type Type;
