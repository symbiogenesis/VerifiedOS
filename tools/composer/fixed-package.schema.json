{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VerifiedOS fixed native package artifact",
  "description": "Immutable output identities and package-relative geometry. Proof objects are data, never acceptance flags; transport paths are outside this content manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "context", "source_closure", "contract", "span", "alignment", "regions", "entry", "exports", "proofs"],
  "properties": {
    "schema_version": {"const": 1},
    "package_id": {"$ref": "#/$defs/name"},
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["target", "specification", "model", "descriptor", "profile", "decoder", "dictionary"],
      "properties": {
        "target": {"$ref": "#/$defs/hash"}, "specification": {"$ref": "#/$defs/hash"},
        "model": {"$ref": "#/$defs/hash"}, "descriptor": {"$ref": "#/$defs/hash"},
        "profile": {"$ref": "#/$defs/hash"}, "decoder": {"$ref": "#/$defs/hash"},
        "dictionary": {"$ref": "#/$defs/hash"}
      }
    },
    "source_closure": {"$ref": "#/$defs/object"},
    "contract": {"$ref": "#/$defs/object"},
    "span": {"type": "integer", "minimum": 1, "maximum": 68719476736},
    "alignment": {"type": "integer", "minimum": 1, "maximum": 68719476736},
    "regions": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "kind", "offset", "alignment", "memory_class", "object"],
        "properties": {
          "name": {"$ref": "#/$defs/name"},
          "kind": {"enum": ["code", "rodata", "initializer"]},
          "offset": {"$ref": "#/$defs/address"},
          "alignment": {"type": "integer", "minimum": 1, "maximum": 68719476736},
          "memory_class": {"type": "integer", "enum": [0, 1]},
          "object": {"$ref": "#/$defs/object"}
        }
      }
    },
    "entry": {"$ref": "#/$defs/address"},
    "exports": {
      "type": "array", "maxItems": 1024,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "offset"],
        "properties": {"name": {"$ref": "#/$defs/name"}, "offset": {"$ref": "#/$defs/address"}}
      }
    },
    "proofs": {
      "type": "object", "additionalProperties": false,
      "required": ["derivation_template", "correspondence", "hyperproperties"],
      "properties": {
        "derivation_template": {"$ref": "#/$defs/object"},
        "correspondence": {"$ref": "#/$defs/object"},
        "hyperproperties": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/object"}}
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,95}$"},
    "address": {"type": "integer", "minimum": 0, "maximum": 68719476735},
    "object": {
      "type": "object", "additionalProperties": false, "required": ["sha256", "bytes"],
      "properties": {"sha256": {"$ref": "#/$defs/hash"}, "bytes": {"type": "integer", "minimum": 1, "maximum": 68719476736}}
    }
  }
}
