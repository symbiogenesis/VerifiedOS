+(* VerifiedOS: file-cache refresh for standard dependency notifications. *)
+let open_documents () =
+  Hashtbl.to_seq file_to_handle |> List.of_seq |> List.sort (fun (a, _) (b, _) -> String.compare a b)
+
+let dependency_error err =
+  state := None;
+  dependency_failure := Some err;
+  List.map
+    (fun (file, _) ->
+      let params =
+        Lsp.Types.PublishDiagnosticsParams.create ~uri:(Lsp.Types.DocumentUri.of_path file)
+          ~diagnostics:[error_diagnostic err] ()
+      in
+      Lsp.Server_notification.PublishDiagnostics params)
+    (open_documents ())
+
+let refresh_open_documents ~config () =
+  dependency_failure := None;
+  List.map
+    (fun (file, handle) ->
+      refresh_project ~config file;
+      diagnostics_for_handle file handle)
+    (open_documents ())
+
+let dependency_update ~config update =
+  try
+    update ();
+    refresh_open_documents ~config ()
+  with
+  | Sys_error msg -> dependency_error (Reporting.Err_general (Parse_ast.Unknown, msg))
+  | Unix.Unix_error (err, call, path) ->
+      dependency_error (Reporting.Err_general (Parse_ast.Unknown, call ^ ": " ^ path ^ ": " ^ Unix.error_message err))
+  | Reporting.Fatal_error err -> dependency_error err
 
