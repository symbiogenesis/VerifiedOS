{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VerifiedOS checker registry",
  "description": "The reader owns rule identity syntax, reach classes, unique IDs and executable binding.",
  "type": "object",
  "required": ["version", "rules", "inactive"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "integer", "const": 1},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "group", "meaning", "ground", "reach"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "group": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "meaning": {"$ref": "#/$defs/text"},
          "ground": {"$ref": "#/$defs/text"},
          "reach": {"type": "string"}
        }
      }
    },
    "inactive": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "ground"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "kind": {"enum": ["retired", "n/a"]},
          "ground": {"$ref": "#/$defs/text"}
        }
      }
    }
  },
  "$defs": {"text": {"type": "string", "minLength": 1, "pattern": "\\S"}}
}
