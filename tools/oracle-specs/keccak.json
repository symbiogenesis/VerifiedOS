{
  "name": "keccak",
  "what": "the frozen Keccak-p[1600] permutation at both round counts, as the model's own answers",
  "answers": "M0.8d: the two transcription defects a known-answer vector found and a structural property did not",
  "sources": [
    "model/model/prelude/prelude.sail",
    "model/model/prelude/errors.sail",
    "model/model/extensions/keccak/keccak_p1600.sail"
  ],
  "probes": [
    {
      "kind": "kf",
      "what": "Keccak-f[1600], the twenty-four-round permutation, over drawn states; every lane of the answer is printed rather than a fold of them, a fold being blind to exactly the lane permutation pi's own defect was",
      "params": [
        { "name": "a", "width": 64, "over": "draw", "show": "h16" },
        { "name": "b", "width": 64, "over": "draw", "show": "h16" }
      ],
      "repeat": 500,
      "seed": "0x0a5c3f19d",
      "body": [
        "var st : keccak_state = vector_init(zeros())",
        "foreach (i from 0 to 24) { st[i] = (a + to_bits_truncate(64, i)) ^ (b << i) }",
        "let res = keccak_p1600(st, 24)"
      ],
      "shows": [
        { "expr": "res[0]", "show": "h16" },
        { "expr": "res[1]", "show": "h16" },
