{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed modeled device-register declarations",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "platform", "harness", "reviewed_functions", "reviewed_layout_sha256"],
  "properties": {
    "schema": {"type": "integer", "const": 1},
    "platform": {"$ref": "#/$defs/devices"},
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["htif"],
      "properties": {"htif": {"$ref": "#/$defs/device"}}
    },
    "reviewed_functions": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/digest"}
    },
    "reviewed_layout_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "text": {"type": "string", "pattern": "\\S"},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(?![\\s\\S])"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
    "devices": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {"$ref": "#/$defs/device"}
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "rationale", "registers"],
      "properties": {
        "kind": {"enum": ["registers", "refused", "memory", "external"]},
        "rationale": {"$ref": "#/$defs/text"},
        "registers": {"type": "array", "items": {"$ref": "#/$defs/register"}}
      },
      "if": {"properties": {"kind": {"const": "registers"}}},
      "then": {"properties": {"registers": {"minItems": 1}}},
      "else": {"properties": {"registers": {"maxItems": 0}}}
    },
    "register": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "offset", "access", "repeat", "bindings", "fields", "views"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "offset": {"type": "integer", "minimum": 0, "multipleOf": 8},
        "access": {"enum": ["ro", "wo", "rw", "command"]},
        "repeat": {"$ref": "#/$defs/text"},
        "bindings": {"$ref": "#/$defs/bindings"},
        "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}},
        "views": {"type": "array", "items": {"$ref": "#/$defs/field"}}
      },
      "if": {"properties": {"access": {"const": "command"}}},
      "then": {"properties": {"fields": {"maxItems": 0}, "views": {"maxItems": 0}}},
      "else": {"properties": {"fields": {"minItems": 1}}}
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "lsb", "width", "bindings"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "lsb": {"type": "integer", "minimum": 0},
        "width": {"type": "integer", "minimum": 1},
        "bindings": {"$ref": "#/$defs/bindings"}
      }
    },
    "bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/binding"}},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "symbol", "contains"],
      "properties": {
        "kind": {"enum": ["function", "let", "type"]},
        "symbol": {"$ref": "#/$defs/text"},
        "contains": {"$ref": "#/$defs/text"}
      }
    }
  }
}
