          "fields": [
            {
              "name": "value",
              "lsb": 0,
              "width": 64,
              "bindings": [
                {
                  "kind": "function",
                  "symbol": "imsic_store",
                  "contains": "unsigned(zero_extend(${width}, data))"
                }
              ]
            }
          ],
          "views": [
            {
              "name": "identity",
              "lsb": 0,
              "width": 6,
              "bindings": [
                {
                  "kind": "function",
                  "symbol": "imsic_store",
                  "contains": "zero_extend(64, data)[${high} .. ${lsb}]"
                }
              ]
            }
          ]
        },
        {
          "name": "eip",
          "offset": 8,
          "access": "rw",
          "repeat": "single word",
          "bindings": [
            {
              "kind": "let",
              "symbol": "IMSIC_EIP",
