      "kind": "registers",
      "rationale": "Two timer words. Four-byte accesses select low or high fields; eight-byte accesses transfer both.",
      "registers": [
        {
          "name": "mtimecmp",
          "offset": 16384,
          "access": "rw",
          "repeat": "single word",
          "bindings": [
            {
              "kind": "let",
              "symbol": "MTIMECMP_BASE",
              "contains": "zero_extend(${offset_hex})"
            }
          ],
          "fields": [
            {
              "name": "lo",
              "lsb": 0,
              "width": 32,
              "bindings": [
                {
                  "kind": "function",
                  "symbol": "clint_load",
                  "contains": "mtimecmp[${high}..${lsb}]"
                }
              ]
            },
            {
              "name": "hi",
              "lsb": 32,
              "width": 32,
              "bindings": [
                {
                  "kind": "function",
                  "symbol": "clint_load",
                  "contains": "mtimecmp[${high}..${lsb}]"
                }
              ]
            }
          ],
          "views": []
        },
        {
          "name": "mtime",
          "offset": 49144,
          "access": "rw",
          "repeat": "single word",
          "bindings": [
            {
              "kind": "let",
              "symbol": "MTIME_BASE",
              "contains": "zero_extend(${offset_hex})"
            }
          ],
          "fields": [
            {
              "name": "lo",
              "lsb": 0,
              "width": 32,
              "bindings": [
                {
                  "kind": "function",
                  "symbol": "clint_load",
                  "contains": "mtime[${high}..${lsb}]"
                }
              ]
            },
            {
              "name": "hi",
              "lsb": 32,
              "width": 32,
              "bindings": [
                {
                  "kind": "function",
                  "symbol": "clint_load",
                  "contains": "mtime[${high}..${lsb}]"
                }
              ]
            }
          ],
          "views": []
        }
      ]
    },
    "imsic": {
      "kind": "registers",
      "rationale": "Doorbell reads return zero; EIP stores clear reserved identity zero. Accessors do not implement these semantics.",
      "registers": [
        {
          "name": "seteipnum",
          "offset": 0,
          "access": "wo",
          "repeat": "single word",
          "bindings": [
