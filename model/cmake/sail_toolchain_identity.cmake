cmake_minimum_required(VERSION 3.26)

function(identity_refuse reason)
    file(REMOVE "${SAIL_IDENTITY_STAMP}")
    message(FATAL_ERROR "Sail generator identity: ${reason}")
endfunction()

foreach(required IN ITEMS SAIL_BIN SAIL_LIBRARY_DIR SAIL_IDENTITY_STAMP)
    if(NOT DEFINED ${required} OR NOT IS_ABSOLUTE "${${required}}")
        identity_refuse("${required} must be an absolute path")
    endif()
endforeach()
if(NOT EXISTS "${SAIL_BIN}" OR IS_DIRECTORY "${SAIL_BIN}")
    identity_refuse("the configured Sail executable is missing")
endif()
execute_process(COMMAND "${SAIL_BIN}" --dir
    RESULT_VARIABLE sail_exit OUTPUT_VARIABLE actual_library
    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_VARIABLE sail_error)
if(NOT sail_exit STREQUAL "0")
    identity_refuse("sail --dir failed: ${sail_error}")
endif()
if(NOT IS_ABSOLUTE "${actual_library}")
    identity_refuse("sail --dir must name an absolute library directory")
endif()
file(REAL_PATH "${SAIL_LIBRARY_DIR}" configured_library)
file(REAL_PATH "${actual_library}" actual_library)
if(NOT IS_ABSOLUTE "${actual_library}" OR NOT actual_library STREQUAL configured_library)
    identity_refuse("sail --dir changed; reconfigure this build tree")
endif()
if(DEFINED ENV{SAIL_NO_PLUGINS})
    identity_refuse("SAIL_NO_PLUGINS disables the generator backends")
endif()
if(DEFINED ENV{SAIL_PLUGIN_DIR})
    if(WIN32)
        identity_refuse("native Sail plugin overrides require the Linux toolchain")
    endif()
    if("$ENV{SAIL_PLUGIN_DIR}" STREQUAL "")
        identity_refuse("SAIL_PLUGIN_DIR must name absolute plugin directories")
    endif()
    string(REPLACE ":" ";" plugin_directories "$ENV{SAIL_PLUGIN_DIR}")
else()
    if(DEFINED ENV{SAIL_DIR} OR DEFINED ENV{DUNE_DIR_LOCATIONS})
        identity_refuse("SAIL_DIR or DUNE_DIR_LOCATIONS requires an explicit SAIL_PLUGIN_DIR")
    endif()
    set(plugin_directories "${configured_library}/../libsail/plugins")
endif()

# This script has no persisted CMake cache. Resolve the solver again in the
# build's PATH, exactly where Sail's solver process is selected.
find_program(selected_z3 NAMES z3)
if(NOT selected_z3)
    identity_refuse("no z3 executable is available in the build environment")
endif()
set(inputs "${SAIL_BIN}" "${selected_z3}" "${CMAKE_CURRENT_LIST_FILE}")
file(GLOB_RECURSE library_files LIST_DIRECTORIES FALSE FOLLOW_SYMLINKS "${configured_library}/lib/*")
file(GLOB_RECURSE sail_sources LIST_DIRECTORIES FALSE FOLLOW_SYMLINKS "${configured_library}/lib/*.sail")
if(NOT sail_sources)
    identity_refuse("the selected Sail library has no .sail source files")
endif()
list(APPEND inputs ${library_files})
set(population "loader ${SAIL_LOADER_IDENTITY}\n")
foreach(directory IN LISTS plugin_directories)
    if(NOT IS_ABSOLUTE "${directory}" OR NOT IS_DIRECTORY "${directory}")
        identity_refuse("a selected plugin directory is missing or not absolute")
    endif()
    file(REAL_PATH "${directory}" directory)
    string(APPEND population "plugins ${directory}\n")
    file(GLOB plugins LIST_DIRECTORIES FALSE "${directory}/*.cmxs")
    list(APPEND inputs ${plugins})
endforeach()
list(REMOVE_DUPLICATES inputs)
list(SORT inputs)
foreach(path IN LISTS inputs)
    if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
        identity_refuse("an enumerated generator input is not a file: ${path}")
    endif()
    file(SHA256 "${path}" digest)
    file(REAL_PATH "${path}" resolved)
    string(APPEND population "${digest}  ${path} -> ${resolved}\n")
endforeach()
string(SHA256 identity "${population}")
set(content "${identity}\n${population}")
set(previous "")
if(EXISTS "${SAIL_IDENTITY_STAMP}")
    file(READ "${SAIL_IDENTITY_STAMP}" previous)
endif()
if(NOT content STREQUAL previous)
    file(WRITE "${SAIL_IDENTITY_STAMP}.pending" "${content}")
    file(RENAME "${SAIL_IDENTITY_STAMP}.pending" "${SAIL_IDENTITY_STAMP}")
endif()
