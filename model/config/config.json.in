// This is a configuration file for the Sail RISC-V emulator.
//
// You can copy and then modify it to create a new configuration file,
// and then use the `--config` option to use it with the
// `sail_riscv_sim` emulator.  If any CMake @VARIABLE@ placeholders
// are present in this file, they will need to be replaced with valid
// values.
//
// This file has an associated JSON Schema, which is generated by the
// Sail compiler as a build artifact.  See the documentation (e.g. the
// top-level README) on how to get the associated schema.
{
  "base": {
    // XLEN is not configurable: the base is RV64 (model/core/xlen.sail).
    // Whether the base ISA is E, in which case accessing
    // x16-31 is reserved and in this implementation will
    // raise an illegal instruction exception.
    "E": false,
    // `mtvec.{direct,vectored}.supported` indicates whether the
    // corresponding mode is supported for `mtvec`.  At least one mode
    // should be supported.  If both modes are supported, the mode on
    // reset is unspecified.
    // The `mtvec.{direct,vectored}.base_alignment` parameters control the alignment
    // of the trap vector base for each mode.  The alignment is
    // specified as the power of 2 of the desired byte alignment, and
    // can range from a minimum of 2 upto a maximum of 24. If
    // unaligned values are written to these CSRs, the lowest bits
    // will be zeroed to respect the specified alignment.
    "mtvec": {
      "direct": {
        "supported": true,
        "base_alignment": 2
      },
      "vectored": {
        "supported": true,
        "base_alignment": 2
      }
    },
    // These settings control whether the specified exceptions
    // cause information to be written into the appropriate
    // `xtval` registers.
    "xtval_nonzero": {
      "illegal_instruction": true,
      // `ebreak` is the only breakpoint source; the trigger module's
      // hardware case is deleted with `Sdtrig` (R-15-079a).
      "breakpoint": true,
      "load_address_misaligned": true,
      "load_access_fault": true,
      "samo_address_misaligned": true,
      "samo_access_fault": true,
      "fetch_address_misaligned": true,
      "fetch_access_fault": true
    },
    "reserved_behavior": {
      // The configuration option determines how to handle the reserved behavior `amocas_odd_registers`.
      // "AMOCAS_Fatal"  – raise a Sail exception, stopping execution.
      // "AMOCAS_Illegal" – treat it as an illegal instruction.
      "amocas_odd_register": "AMOCAS_Illegal",
      // The configuration option determines how to handle the reserved behavior `xenvcfg.CBIE` with 0b10.
      // The configuration option determines how to handle the reserved behavior `xtvec[Mode] >= 2`.
      // "Xtvec_Fatal"  – raise a Sail exception, stopping execution.
      // "Xtvec_Ignore" – use old Mode of xtvec.
      "xtvec_mode": "Xtvec_Ignore"
    },
    "mstatus": {
      // The legal values for the FS and VS fields in this CSR are
      // specified by the two fields below.  Their values can be one
      // of:
      // - "ExtContext_FourState" allows all values {Off, Initial, Clean, Dirty}.
      // - "ExtContext_TwoState" allows {Off, Dirty}, and writes of Initial and Clean get written as Dirty.
      // - "ExtContext_Off" allows only {Off}.  This makes the field read-only zero.
      "vs_legal_states": "ExtContext_FourState"
    },
    // Set the version of the privileged ISA. `"Privileged_ISA_1_13"`
    // is the latest that the Sail model supports.  The other
    // supported value for this field is:
    // - `"Privileged_ISA_1_12"`
    // - `"Privileged_ISA_1_11"`
    // Note that currently, not all functionality for these versions
    // is available currently, and not all versions of the privileged
    // ISA can be specified.
    "privileged_isa_version": "Privileged_ISA_1_13"
  },
  "memory": {
    // This specifies the number of implemented physical address bits.
    // This is less than or equal to 64: the base is RV64 and there is
    // no address translation. Architectural bits higher than
    // `physaddr_bits` in physical addresses are effectively read-only zero.
    // This is required to be 13 or higher to avoid representing empty
    // bitvectors in the model and since it is unlikely real implementations
    // will have lower values.
    "physaddr_bits": @CONFIG__PHYSADDR__BITS@,
    // These settings control global support for misaligned access so they are
    // checked before address translation. `misaligned_fault` in
    // `regions` is checked after address translation.
    "misaligned": {
      // `exceptions` specifies the treatment of misaligned accesses
      // before address translation.  If a fault is specified for an access,
      // it will have a higher priority than memory-protection faults arising from
      // that access if it were allowed to proceed.
      "exceptions": {
        // A misaligned scalar or vector load/store, or an AMO, can either proceed
        // without a fault (use `{"None" : null}`), or raise an access fault
        // (use `{"Some": "AccessFault"}`) or a misaligned exception
        // (use `{"Some": "AlignmentException"}`).
        // This option controls scalar loads/stores.
        "load_store": {
          "None" : null
        },
        // A misaligned vector load/store can be configured
        // independently of the scalar case above, but uses the same
        // option values.
        "vector": {
          "None": null
        },
        // Similarly, a misaligned AMO can be configured with the same
        // option values.
        "amo": {
          "None": null
        }
      },
      // If multiple memory operations are needed (e.g. when an access
      // straddles a page boundary), this controls whether they are
      // done in increasing or decreasing address order. This is
      // architecturally observable because some store operations may
      // succeed, and even for loads the resulting `xtval` may depend
      // on this setting.
      "order_decreasing": false,
      // If a misaligned access was specified to have no fault in
      // `exceptions` above, the PMAs for the access, including the
      // optional Misaligned Atomicity Granule (MAG) PMA, specify how
      // it is handled.  If no MAG PMA is specified, or the MAG does
      // not apply to the access, the `default_allowed_within_exp`
      // value below specifies this handling.
      //
      // Memory accesses that span multiple naturally aligned
      // 2^default_allowed_within_exp sized regions will be split into
      // multiple memory operations. 0 means all misaligned accesses
      // will be split.  The maximum value is 12 (one page).
      "default_allowed_within_exp": 0,
      // If the access gets split due to `default_allowed_within_exp`
      // then the size of the operations will be one byte if
      // `byte_by_byte` is set, otherwise they will be the maximum
      // size possible based on the alignment. For example a 4-byte
      // access to address 0x2 will use two 2-byte operations.
      "byte_by_byte": false
    },
    // Address to write DTB to (if provided). This must be in a suitable memory
    // region (see `memory.regions`).
    "dtb_address": {
      "len": 64,
      "value": "0x1000"
    },
    // The two static latency classes of main memory (R-15-247). Each region
    // below is placed on exactly one of them by `memory_class`, and these are
    // the constants that placement selects between: one fixed latency per
    // class, no cache, no migration, and no promotion between them.
    //
    // **Every number here is a placeholder.** R-15-247m measures them on a
    // repaired megabit-class macro carrying complete tag, ECC, refresh,
    // discharge, and routing overhead, and admits no density figure as an
    // architectural input ahead of that measurement; nothing in the model
    // computes with them and no document quotes them. `qualified` is what says
    // so on the face of the generated devicetree, and it stays `false` until
    // that measurement lands.
    //
    // Latency is in cycles and retention in microseconds. The first class is
    // latched, so its retention corner, refresh, and discharge dwell are
    // absent rather than small, and the validator refuses anything else.
    "classes": {
      "first": {
        "qualified": false,
        "usable_density_mbit_per_mm2": 40,
        "banks": 64,
        "retention_floor_us": 0,
        "retention_ceiling_us": 0,
        "read_cycles": 3,
        "write_cycles": 3,
        "refresh_cycles": 0,
        "discharge_cycles": 0
      },
      "second": {
        "qualified": false,
        "usable_density_mbit_per_mm2": 320,
        "banks": 4096,
        "retention_floor_us": 60000000,
        "retention_ceiling_us": 3600000000,
        "read_cycles": 30,
        "write_cycles": 45,
        "refresh_cycles": 20,
        "discharge_cycles": 4096
      }
    },
    // The locations and sizes of memory regions and their PMAs.  These regions
    // are required to be aligned to 4K (page) boundaries.  To specify
    // the `misaligned` PMA attribute for a region, see the comments for
    // `memory.misaligned.exceptions` above.
    // The optional misaligned atomicity granule (MAG) can be specified as a
    // power of 2, upto a maximum of a page size (i.e. 12). For
    // Zama16b, for e.g., the specified value should be 4. A value of
    // 0 indicates that the MAG attribute is not present.
    "regions": [
      // ROM, 16 KiB at 0x1000, holding the boot ROM and the attested
      // devicetree written at `memory.dtb_address`. The 4 KiB this was is
      // upstream's default rather than this platform's budget: R-09-007 has
      // the tree declare core classes, islands, the NoC schedule, OPP tables,
      // and radio calibration and limit values, and the first of those five
      // is what stopped fitting.
      {
        "base": {
          "len": 64,
          "value": "0x1000"
        },
        "size": {
          "len": 64,
          "value": "0x4000"
        },
        "attributes": {
          "mem_type" : "IOMemory",
          "cacheable": true,
          "coherent": false,
          "executable": false,
          "readable": true,
          "writable": false,
          "read_idempotent": true,
          "write_idempotent": true,
          "misaligned_exceptions": {
            "load_store": {
              "None" : null
            },
            "vector": {
              "None" : null
            },
            "amo": "AccessFault"
          },
          "atomic_support": "AMONone",
          "misaligned_atomicity_granule_size_exp": 0,
          "vector_misaligned_atomicity_granule_size_exp": 0,
          "supports_cbo_zero": false,
          // A device endpoint is on neither latency class (R-15-247).
          "memory_class": { "None": null },
          // No region here is a datapath's software-managed scratchpad
          // (R-15-165, R-15-167, sys/pma.sail), and no configuration this tree
          // ships declares one. `scratchpad_bytes` is one of R-15-108's frozen
          // parameters, the exploration that selects it has not run, and every
          // class row below says so with `frozen: false`, so a range written in
          // ahead of it would be a placeholder becoming an architectural input.
          // What the model carries instead is the shape, and a composition
          // declaring a wrong one is refused
          // (postlude/validate_config.sail).
          "scratchpad": { "None": null }
        },
        "include_in_device_tree": false
      },
      // MMIO
      {
        "base": {
          "len": 64,
          "value": "0x2000000"
        },
        "size": {
          "len": 64,
          "value": "0x10000000"
        },
        "attributes": {
          "mem_type": "IOMemory",
          "cacheable": false,
          "coherent": true,
          "executable": false,
          "readable": true,
          "writable": true,
          "read_idempotent": false,
          "write_idempotent": false,
          "misaligned_exceptions": {
            "load_store": {
              "None" : null
            },
            "vector": {
              "None" : null
            },
            "amo": "AccessFault"
          },
          "atomic_support": "AMONone",
          "misaligned_atomicity_granule_size_exp": 0,
          "vector_misaligned_atomicity_granule_size_exp": 0,
          "supports_cbo_zero": false,
          "memory_class": { "None": null },
          "scratchpad": { "None": null }
        },
        "include_in_device_tree": false
      },
      // RAM, first class: the scalar working set and every cycle-critical
      // array (R-15-247s).
      {
        "base": {
          "len": 64,
          "value": "0x80000000"
        },
        "size": {
          "len": 64,
          "value": "0x80000000"
        },
        "attributes": {
          "mem_type": "MainMemory",
          "cacheable": true,
          "coherent": true,
          "executable": true,
          "readable": true,
          "writable": true,
          "read_idempotent": true,
          "write_idempotent": true,
          "misaligned_exceptions": {
            "load_store": {
              "None" : null
            },
            "vector": {
              "None" : null
            },
            "amo": "AccessFault"
          },
          "atomic_support": "AMOCASQ",
          "misaligned_atomicity_granule_size_exp": 4,
          "vector_misaligned_atomicity_granule_size_exp": 4,
          "supports_cbo_zero": true,
          "memory_class": { "Some": "FirstClass" },
          "scratchpad": { "None": null }
        },
        "include_in_device_tree": true
      },
      // RAM, second class: bulk by volume. It is executable because
      // second-class code placement is admitted and priced rather than
      // forbidden (R-15-247j), and it carries every other attribute the first
      // class carries because the boundary is latency-criticality and nothing
      // else (R-15-247s).
      {
        "base": {
          "len": 64,
          "value": "0x100000000"
        },
        "size": {
          "len": 64,
          "value": "0x200000000"
        },
        "attributes": {
          "mem_type": "MainMemory",
          "cacheable": true,
          "coherent": true,
          "executable": true,
          "readable": true,
          "writable": true,
          "read_idempotent": true,
          "write_idempotent": true,
          "misaligned_exceptions": {
            "load_store": {
              "None" : null
            },
            "vector": {
              "None" : null
            },
            "amo": "AccessFault"
          },
          "atomic_support": "AMOCASQ",
          "misaligned_atomicity_granule_size_exp": 4,
          "vector_misaligned_atomicity_granule_size_exp": 4,
          "supports_cbo_zero": true,
          "memory_class": { "Some": "SecondClass" },
          "scratchpad": { "None": null }
        },
        "include_in_device_tree": true
      }
    ]
  },
  "platform": {
    // `mvendorid`, `marchid`, `mimpid` and `mconfigptr` are hardwired
    // zero (R-15-052a) and have no configuration; `mhartid` is the one
    // implementation identifier with a consumer (R-15-052b). It is an
    // index into `core_roster` below rather than a value beside it, and
    // the validator refuses a composition whose roster does not name it.
    "hartid": 0,
    // The core-class table (R-15-113, core/core_class.sail). One Sail model
    // parameterized by class (R-15-005): the classes share the base ISA, the
    // capability model, and the kernel binary, and differ only in datapath.
    //
    // **Every number here is a reference instantiation, not a freeze.** VLEN per
    // class, core count per class, issue width, pipeline depth, and scratchpad
    // size are R-15-108's frozen microarchitectural parameters and are selected
    // by a design-space exploration that has not run. `frozen` is what says so
    // on the face of the generated devicetree, and it stays `false` until that
    // exploration lands. In a row whose `frozen` is false a zero reads as *not
    // selected*; a zero in a frozen row reads as *absent*.
    //
    // A vectorless class declares zero for every vector and matrix field, and
    // the validator refuses anything else: no vector permutation instruction is
    // reachable on the sentinel or the RoT, which is why they hash SHA-3/SHAKE
    // in plain 64-bit integer with `Zbb` rotations rather than wanting a
    // hardware round unit (R-15-041, R-15-042, R-15-059, R-09-005a).
    //
    // The C row's vector geometry tracks `extensions.V` above rather than
    // restating it. One build realizes one VLEN, `vlen_exp` being a Sail
    // type-level configuration that sizes the vector register file, so the
    // composed hart's class must declare the geometry this model was built at
    // and the validator refuses a composition where the two disagree. Binding
    // the template here is what keeps every generated test-matrix configuration
    // consistent with its own class table.
    //
    // The C row's Keccak unit tracks that geometry for the same reason. The
    // frozen permutation is one instruction over a 2048-bit element group of 32
    // SEW=64 elements and a register group tops out at LMUL=8, so the unit needs
    // a 64-bit element width and at least 256 bits of vector length; the
    // generated matrix runs below both, and a row declaring the unit there would
    // be declaring a datapath whose one instruction cannot decode on it
    // (R-15-056, R-15-057a, postlude/validate_config.sail). The V and M rows are
    // at 4096 and 1024 bits and carry it unconditionally.
    "core_classes": {
      "c": {
        "frozen": false,
        "vlen_exp": @CONFIG__V__VLEN_EXP@,
        "elen_exp": @CONFIG__V__ELEN_EXP@,
        "lanes": 0,
        "matrix_int8_dim": 0,
        "matrix_bf16_dim": 0,
        "scratchpad_bytes": 0,
        "issue_width": 2,
        "pipeline_depth": 0,
        "keccak_unit": @CONFIG__KECCAK_UNIT@,
        "replicated": false
      },
      "v": {
        "frozen": false,
        "vlen_exp": 12,
        "elen_exp": 6,
        "lanes": 8,
        "matrix_int8_dim": 0,
        "matrix_bf16_dim": 0,
        "scratchpad_bytes": 0,
        "issue_width": 2,
        "pipeline_depth": 0,
        "keccak_unit": true,
        "replicated": false
      },
      "m": {
        "frozen": false,
        "vlen_exp": 10,
        "elen_exp": 6,
        "lanes": 0,
        "matrix_int8_dim": 32,
        "matrix_bf16_dim": 16,
        "scratchpad_bytes": 0,
        "issue_width": 2,
        "pipeline_depth": 0,
        "keccak_unit": true,
        "replicated": false
      },
      "s": {
        "frozen": false,
        "vlen_exp": 0,
        "elen_exp": 0,
        "lanes": 0,
        "matrix_int8_dim": 0,
        "matrix_bf16_dim": 0,
        "scratchpad_bytes": 0,
        "issue_width": 2,
        "pipeline_depth": 0,
        "keccak_unit": false,
        "replicated": true
      },
      "rot": {
        "frozen": false,
        "vlen_exp": 0,
        "elen_exp": 0,
        "lanes": 0,
        "matrix_int8_dim": 0,
        "matrix_bf16_dim": 0,
        "scratchpad_bytes": 0,
        "issue_width": 1,
        "pipeline_depth": 0,
        "keccak_unit": false,
        "replicated": false
      }
    },
    // The composed core roster (R-15-052b, R-09-007). One entry per hart,
    // carrying the two things the kernel reads out of `mhartid` beside its
    // per-hart state: the core's class and its island binding. Counts are
    // composition parameters and not architecture (R-15-113), so no count is
    // declared anywhere: a class's count is the number of its entries here.
    //
    // `pinned` records an admission outcome rather than a favour granted per
    // device (R-15-114): membership is decided by the R-11-011 switch-duty rule,
    // and the radio V pair and the sentinel are the current members. `fec_units`
    // follows the pinned radio pair for the same reason, the LDPC and polar
    // decoders being fixed-geometry core-issued attachments with no DMA
    // mastership and no firmware (R-15-119, R-12-038).
    //
    // The S row is one entry, not two: the sentinel is one architectural core
    // realized as a detection-only lockstepped pair, and the replication is a
    // field of its class rather than a second hart (R-16-008d, R-16-008e).
    "core_roster": [
      { "hartid": 0,  "class": "CoreClass_C",   "island": 0, "pinned": false, "fec_units": false },
      { "hartid": 1,  "class": "CoreClass_C",   "island": 0, "pinned": false, "fec_units": false },
      { "hartid": 2,  "class": "CoreClass_C",   "island": 0, "pinned": false, "fec_units": false },
      { "hartid": 3,  "class": "CoreClass_C",   "island": 0, "pinned": false, "fec_units": false },
      { "hartid": 4,  "class": "CoreClass_C",   "island": 0, "pinned": false, "fec_units": false },
      { "hartid": 5,  "class": "CoreClass_C",   "island": 0, "pinned": false, "fec_units": false },
      { "hartid": 6,  "class": "CoreClass_V",   "island": 1, "pinned": false, "fec_units": false },
      { "hartid": 7,  "class": "CoreClass_V",   "island": 1, "pinned": false, "fec_units": false },
      { "hartid": 8,  "class": "CoreClass_V",   "island": 1, "pinned": false, "fec_units": false },
      { "hartid": 9,  "class": "CoreClass_V",   "island": 1, "pinned": false, "fec_units": false },
      { "hartid": 10, "class": "CoreClass_V",   "island": 2, "pinned": true,  "fec_units": true  },
      { "hartid": 11, "class": "CoreClass_V",   "island": 2, "pinned": true,  "fec_units": true  },
      { "hartid": 12, "class": "CoreClass_M",   "island": 3, "pinned": false, "fec_units": false },
      { "hartid": 13, "class": "CoreClass_M",   "island": 3, "pinned": false, "fec_units": false },
      { "hartid": 14, "class": "CoreClass_S",   "island": 4, "pinned": true,  "fec_units": false },
      // The RoT is not pinned because it is not slotted: it is the platform's
      // only management processor, in its own clock and power island and
      // outside the die's cyclic executive, so R-11-011's switch-duty rule
      // does not reach it and there is no slot for pinning to delete.
      { "hartid": 15, "class": "CoreClass_RoT", "island": 5, "pinned": false, "fec_units": false }
    ],
    // Cache block size, specified as a power of 2.
    "cache_block_size_exp": 6,
    "clint": {
      // Whether the platform contains a CLINT.
      "supported": true,
      // If supported, this must be in a suitable IO memory region (see `memory.regions`).
      // Otherwise, these values can be left as 0.
      "base": 33554432,
      "size": 786432
    },
    "imsic": {
      // The machine-level interrupt file. Only the pending array exists: the
      // supervisor and guest/VS files and the whole indirect interface are
      // excluded (R-15-064, R-15-065). An MSI is a store to this window, so
      // send authority is a write capability rather than a side table.
      "supported": true,
      // If supported, this must be in a suitable IO memory region (see `memory.regions`).
      "base": 34603008,
      "size": 4096
    },
    "revocation": {
      // The revocation sidecar (R-08-005a). `base` is the register-slave
      // window the kernel revocation path updates the bitmap through, in IO
      // memory; the interval is the composition's revocable region, in main
      // memory, 64-byte aligned and no wider than the plane covers
      // (core/revocation.sail).
      "supported": true,
      "base": 35651584,
      "interval_base": 2147516416,
      "interval_size": 32768
    },
    "memory_sequencer": {
      // The refresh and discharge sequencer (R-15-247h). `base` is the
      // register-slave window, in IO memory; nothing on this die reaches it,
      // the RoT being its only sequencer, and the model refuses every access
      // to it (sys/platform.sail).
      //
      // The four cadence figures are the composition-fixed schedule the slave
      // runs over the second latency class's banks
      // (sys/memory_sequencer.sail). The two `banks_per_` figures are the
      // simultaneous-activation sets, which are placeholders until M0.17
      // prices them against the droop, thermal-coupling, and power-signature
      // envelope (R-15-247g); what the validator holds is the shape, that the
      // discharge set is no larger than the refresh set, that each phase
      // interval covers the operation it issues, and that the full refresh
      // sweep is inside the second class's retention floor.
      "supported": true,
      "base": 36700160,
      "size": 4096,
      "banks_per_refresh_phase": 8,
      "refresh_phase_cycles": 58000000,
      "banks_per_discharge_phase": 4,
      "discharge_phase_cycles": 8192
    },
    "clock_frequency": 1000000000,
    "instructions_per_tick": 2,
    "wfi_is_nop": false,
    // The maximum increment in the time CSR before a wait instruction
    // (e.g. WFI, WRS.NTO, WRS.STO) that is not a NOP expires its
    // wait. It is not possible to wait indefinitely.
    //
    // If WFI or WRS.STO (Short TimeOut) exceed this limit in
    // non-machine privilege with mstatus[TW] set, an illegal
    // instruction is raised. Otherwise they retire successfully.
    //
    // Note: it is also legal for these instructions to spuriously
    // retire successfully at any point, but there is currently no
    // configuration option for this behaviour.
    "max_time_to_wait": 10
  },
  // The timing annotations (isa-profile.md §9, core/timing.sail). One entry per
  // operation class the register states a latency contract over, plus the two
  // partition-switch constants that are per core class because one kernel binary
  // budgets a switch on every class it may run on (R-07-012, R-15-220).
  //
  // **Every number here is a placeholder.** R-17-041 makes the latency
  // magnitudes a crown-jewel specification and nothing measures one yet: this
  // profile implements `Zicntr` and `Zihpm` in no lifecycle state, so no counter
  // exists to read a cycle from, and development measurement rides the
  // lifecycle-gated Debug Module trace on real RTL (R-15-077). `qualified` is
  // what says so on the face of the generated devicetree and it stays `false`
  // until that measurement lands; nothing in the model computes with these, and
  // the freeze report is barred from carrying a host-timed column beside them.
  //
  // The scalar rows are one table because the scalar front end is one shared
  // microarchitecture across every class, which is what makes kernel-path WCET a
  // single analysis (R-15-112); the vector rows are this build's, one build
  // realizing one VLEN. `vector_mem_indexed` is the fully-conflicted bound, every
  // element resolving to one bank, which is how an access whose observed latency
  // varies still yields one sound entry (R-15-085a, R-15-085b).
  //
  // `keccak_24` and `keccak_12` are the frozen permutation's two round counts,
  // both on the `Zvkt` fixed-latency list (R-15-053, R-15-056a). They are two
  // rows and not one row scaled by the immediate, because a latency computed
  // from a field of the instruction is a latency with somewhere for an operand
  // to arrive. At a VLEN=256 configuration these are the C-class figures
  // R-15-059a states, the 2048-bit element group being LMUL=8 there, rather than
  // figures extrapolated from the V class.
  "timing": {
    "operations": {
      "qualified": false,
      "integer": 1,
      "multiply": 3,
      "divide": 34,
      "branch": 1,
      "csr": 1,
      "load": 1,
      "store": 1,
      "atomic": 2,
      "cap_inspect": 1,
      "cap_derive": 1,
      "cap_select": 1,
      "cap_clear": 1,
      "cap_load": 1,
      "cap_store": 1,
      "load_tags": 2,
      "reclaim": 16,
      "block_zero": 2,
      "block_scrub": 8,
      "vector_integer": 4,
      "vector_float": 8,
      "vector_divide": 40,
      "vector_mem_unit": 8,
      "vector_mem_indexed": 32,
      "keccak_24": 24,
      "keccak_12": 12
    },
    // `vmclear_cycles` is zero on the vectorless classes and the validator
    // refuses anything else: the instruction traps there like any unallocated
    // encoding, so a latency for it would be a cost for something that cannot be
    // issued (R-15-069d). `fence_t_cycles` is present on every class, the fence
    // being core surface everywhere and completing at its padded bound rather
    // than early (R-15-218).
    "switch": {
      "c":   { "vmclear_cycles": 64,   "fence_t_cycles": 32 },
      "v":   { "vmclear_cycles": 1024, "fence_t_cycles": 32 },
      "m":   { "vmclear_cycles": 2048, "fence_t_cycles": 32 },
      "s":   { "vmclear_cycles": 0,    "fence_t_cycles": 32 },
      "rot": { "vmclear_cycles": 0,    "fence_t_cycles": 32 }
    }
  },  "extensions": {
    "M": {
      "supported": true
    },
    "A": {
      "supported": true
    },
    "V": {
      // `support_level` must be one of the below strings:
      // . "Disabled" for no vector extension support
      // . "Integer" for Zve*x support
      // . "Float_single" for Zve*f support
      // . "Float_double" for Zve*d support
      // . "Full" for the full V extension
      // Note that `support_level` requires compatible
      // values for `vlen_exp` and `elen_exp` below.
      // For e.g. Zve32x and Zve32f require `elen_exp` >= 5,
      // Zve64x, Zve64f, and Zve64d require `elen_exp` >= 6,
      // and V requires `elen_exp` >= 6 and `vlen_exp` >= 7.
      "support_level": "@CONFIG__V__SUPPORT@",
      // `vlen_exp` and `elen_exp` should be between 3 and 16,
      // inclusive.  If `support_level` is `"Disabled"`, then these
      // should be left as 3 (or any other legal value).
      "vlen_exp": @CONFIG__V__VLEN_EXP@,
      "elen_exp": @CONFIG__V__ELEN_EXP@,
      "reserved_behavior": {
        // This determines how to handle attempts by vsetvli, vsetivli,
        // and vsetvl to set an unsupported or reserved vtype.
        // "IllegalVtype_SetVill" - set vtype.vill, set vl to zero, and write rd.
        // "IllegalVtype_Illegal" - treat it as an illegal instruction.
        // "IllegalVtype_Fatal"   - raise a Sail exception, stopping execution.
        "illegal_vtype": "IllegalVtype_SetVill"
      },
      "vl_use_ceil": false,
      // The maximum index EEW for indexed vector addressing mode, as
      // a power of 2.  This must be at least 3 but must not exceed
      // the supported ELEN.
      "max_index_eew_exp": @CONFIG__V__ELEN_EXP@
    },
    "B": {
      "supported": true
    },
    // This extension just asserts that the cache block size is 64 bytes.
    // If you enable this you also need to ensure `platform.cache_block_size_exp`
    // is 6, otherwise you will get a config validation error.
    "Zic64b": {
      "supported": true
    },
    "Zicboz": {
      "supported": true
    },
    "Ziccamoa": {
      "supported": true
    },
    "Ziccamoc": {
      "supported": true
    },
    "Ziccif": {
      "supported": true
    },
    "Zicclsm": {
      "supported": true
    },
    "Zicond": {
      "supported": true
    },
    "Zicsr": {
      "supported": true
    },
    "Zmmul": {
      "supported": false
    },
    "Zaamo": {
      "supported": false
    },
    "Zabha": {
      "supported": true
    },
    "Zacas": {
      "supported": true
    },
    // This extension just asserts that each memory region has a MAG
    // PMA of 16 bytes.  If you enable this you also need to ensure
    // `misaligned_atomicity_granule_size_exp` for each coherent and
    // cacheable main memory region is 4, otherwise you will get a
    // config validation error.
    "Zama16b": {
      "supported": true
    },
    "Zba": {
      "supported": false
    },
    "Zbb": {
      "supported": false
    },
    "Zbs": {
      "supported": false
    },
    "Zbc": {
      "supported": true
    },
    "Zbkb": {
      "supported": true
    },
    "Zbkc": {
      "supported": true
    },
    "Zbkx": {
      "supported": true
    },
    "Zkt": {
      "supported": true
    },
    "Zvfbfmin": {
      "supported": true
    },
    "Zvfbfwma": {
      "supported": true
    },
    "Zvfh": {
      "supported": true
    },
    "Zvfhmin": {
      "supported": true
    },
    "Zvbb": {
      "supported": true
    },
    "Zvbc": {
      "supported": @CONFIG_ELEN_IS_64@
    },
    "Zvkb": {
      "supported": false
    },
    "Zvkg": {
      "supported": true
    },
    "Zvkned": {
      "supported": true
    },
    "Zvknha": {
      "supported": true
    },
    "Zvknhb": {
      "supported": @CONFIG_ELEN_IS_64@
    },
    "Zvkt": {
      "supported": true
    }
  }
}
