// The profile configuration (docs/isa-profile.md). Every row the JSON config
// system can express is set to the frozen profile; rows it cannot express are
// the source-level worklist recorded in docs/implementation-checklist.md.
// Keys disappear from this file as M0.6c deletes the surface behind them: an
// extension cut out of the model has no `supported` switch left to set.
// The F/D residue is gone: the c4 batch took scalar floating point out of the
// model (R-15-039) and with it the validator rule that required F/D under a
// float-capable V level, so the vector-FP-without-scalar-FP fork (R-15-040) is
// the configuration rather than a deviation from it. No key here is a
// deliberate non-profile value.
{
  "base": {
    "E": false,
    // direct-only trap entry; MTCC replaces mtvec at the M0.6e transplant (R-15-073).
    "mtvec": {
      "direct": { "supported": true, "base_alignment": 2 },
      "vectored": { "supported": false, "base_alignment": 2 }
    },
    // mtval reports detail (R-15-073a).
    "xtval_nonzero": {
      "illegal_instruction": true,
      "breakpoint": true,
      "load_address_misaligned": true,
      "load_access_fault": true,
      "samo_address_misaligned": true,
      "samo_access_fault": true,
      "fetch_address_misaligned": true,
      "fetch_access_fault": true
    },
    "reserved_behavior": {
      "amocas_odd_register": "AMOCAS_Illegal",
      "xtvec_mode": "Xtvec_Ignore"
    },
    "mstatus": {
      "vs_legal_states": "ExtContext_FourState"
    },
    "privileged_isa_version": "Privileged_ISA_1_13"
  },
  "memory": {
    // R-15-002a: single physical space, 36 bits wide.
    "physaddr_bits": 36,
    // R-15-084: misaligned accesses trap and are never split.
    "misaligned": {
      "exceptions": {
        "load_store": { "Some": "AlignmentException" },
        "vector": { "Some": "AlignmentException" },
        "amo": { "Some": "AlignmentException" }
      },
      "order_decreasing": false,
      "default_allowed_within_exp": 0,
      "byte_by_byte": false
    },
    "dtb_address": { "len": 64, "value": "0x1000" },
    "regions": [
      // ROM
      {
        "base": { "len": 64, "value": "0x1000" },
        "size": { "len": 64, "value": "0x1000" },
        "attributes": {
          "mem_type": "IOMemory",
          "cacheable": true,
          "coherent": false,
          "executable": false,
          "readable": true,
          "writable": false,
          "read_idempotent": true,
          "write_idempotent": true,
          "misaligned_exceptions": {
            "load_store": { "None": null },
            "vector": { "None": null },
            "amo": "AccessFault"
          },
          "atomic_support": "AMONone",
          "misaligned_atomicity_granule_size_exp": 0,
          "vector_misaligned_atomicity_granule_size_exp": 0,
          "supports_cbo_zero": false
        },
        "include_in_device_tree": false
      },
      // MMIO
      {
        "base": { "len": 64, "value": "0x2000000" },
        "size": { "len": 64, "value": "0x10000000" },
        "attributes": {
          "mem_type": "IOMemory",
          "cacheable": false,
          "coherent": true,
          "executable": false,
          "readable": true,
          "writable": true,
          "read_idempotent": false,
          "write_idempotent": false,
          "misaligned_exceptions": {
            "load_store": { "None": null },
            "vector": { "None": null },
            "amo": "AccessFault"
          },
          "atomic_support": "AMONone",
          "misaligned_atomicity_granule_size_exp": 0,
          "vector_misaligned_atomicity_granule_size_exp": 0,
          "supports_cbo_zero": false
        },
        "include_in_device_tree": false
      },
      // RAM: 2 GiB at 0x8000_0000, inside the 36-bit space.
      {
        "base": { "len": 64, "value": "0x80000000" },
        "size": { "len": 64, "value": "0x80000000" },
        "attributes": {
          "mem_type": "MainMemory",
          "cacheable": true,
          "coherent": true,
          "executable": true,
          "readable": true,
          "writable": true,
          "read_idempotent": true,
          "write_idempotent": true,
          "misaligned_exceptions": {
            "load_store": { "None": null },
            "vector": { "None": null },
            "amo": "AccessFault"
          },
          // R-15-024: Zaamo-level RMW, no CAS, no reservations.
          "atomic_support": "AMOArithmetic",
          "misaligned_atomicity_granule_size_exp": 0,
          "vector_misaligned_atomicity_granule_size_exp": 0,
          "supports_cbo_zero": true
        },
        "include_in_device_tree": true
      }
    ]
  },
  "platform": {
    // R-15-052b: the sole implementation identifier with a consumer.
    // The other four are hardwired zero in the model and have no key.
    "hartid": 0,
    // the CBO block Zicboz allocates and cloadtags groups by (R-15-060, R-15-007q).
    "cache_block_size_exp": 6,
    // mtime/mtimecmp are memory-mapped, programmed directly by the kernel (R-15-063).
    "clint": { "supported": true, "base": 33554432, "size": 786432 },
    "clock_frequency": 1000000000,
    "instructions_per_tick": 2,
    "wfi_is_nop": false,
    "max_time_to_wait": 10
  },
  "extensions": {
    "M": { "supported": true },
    // A narrowed to Zaamo + Zabha (R-15-024): the umbrella is off, the parts are on.
    "A": { "supported": false },
    // C-class first: VLEN=256, ELEN=64 (per-class parameterization is M0.8).
    "V": {
      "support_level": "Full",
      "vlen_exp": 8,
      "elen_exp": 6,
      "reserved_behavior": {
        "illegal_vtype": "IllegalVtype_SetVill"
      },
      "vl_use_ceil": false,
      "max_index_eew_exp": 6
    },
    // B = Zba+Zbb+Zbs exactly, single-bit only at Zbs (R-15-067).
    "B": { "supported": true },
    "Zic64b": { "supported": false },
    "Zicboz": { "supported": true },
    "Ziccamoa": { "supported": false },
    "Ziccamoc": { "supported": false },
    "Ziccif": { "supported": false },
    "Zicclsm": { "supported": false },
    "Zicond": { "supported": true },
    "Zicsr": { "supported": true },
    "Zmmul": { "supported": false },
    "Zaamo": { "supported": true },
    "Zabha": { "supported": true },
    "Zacas": { "supported": false },
    "Zama16b": { "supported": false },
    "Zba": { "supported": false },
    "Zbb": { "supported": false },
    "Zbs": { "supported": false },
    "Zbc": { "supported": false },
    "Zbkb": { "supported": true },
    "Zbkc": { "supported": true },
    "Zbkx": { "supported": true },
    "Zkt": { "supported": true },
    "Zvfbfmin": { "supported": false },
    "Zvfbfwma": { "supported": false },
    "Zvfh": { "supported": false },
    "Zvfhmin": { "supported": false },
    "Zvbb": { "supported": true },
    "Zvbc": { "supported": true },
    "Zvkb": { "supported": false },
    "Zvkg": { "supported": true },
    "Zvkned": { "supported": true },
    "Zvknha": { "supported": false },
    "Zvknhb": { "supported": true },
    "Zvkt": { "supported": true }
  }
}
