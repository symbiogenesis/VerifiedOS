// The profile configuration (docs/isa-profile.md). Every row the JSON config
// system can express is set to the frozen profile; rows it cannot express are
// the source-level worklist recorded in docs/implementation-checklist.md.
// Keys disappear from this file as M0.6c deletes the surface behind them: an
// extension cut out of the model has no `supported` switch left to set.
// One deliberate non-profile value, the standing residue: F and D are ON
// because the config validator requires scalar F/D under any float-capable V
// level, while the profile's vector-FP-without-scalar-FP is the R-15-040
// Sail-modeled fork, booked for M0.6c's c4 batch.
{
  "base": {
    "xlen": 64,
    "E": false,
    // R-15-052: no runtime ISA morphing, no runtime CHERI disable.
    "writable_misa": false,
    // no less-privileged mode for FIOM to order against (R-15-003).
    "writable_fiom": false,
    // R-15-077: counters deleted; all read-only zero is the closest config form.
    "scounteren_writable_bits": { "len": 32, "value": "0x0000_0000" },
    "mcounteren_writable_bits": { "len": 32, "value": "0x0000_0000" },
    // direct-only trap entry; MTCC replaces mtvec at the M0.6e transplant (R-15-073).
    "mtvec": {
      "direct": { "supported": true, "base_alignment": 2 },
      "vectored": { "supported": false, "base_alignment": 2 }
    },
    // S is off; these values are required by the schema but ignored.
    "stvec": {
      "direct": { "supported": true },
      "vectored": { "supported": false, "base_alignment": 2 }
    },
    // no delegate exists (R-15-003); ignored with the CSRs absent.
    "medeleg": { "delegatable_bits": { "len": 64, "value": "0x0000_0000_0000_0000" } },
    "mideleg": { "delegatable_bits": { "len": "xlen", "value": "0x0000_0000_0000_0000" } },
    // mtval reports detail (R-15-073a); page-fault rows are dead with no MMU.
    "xtval_nonzero": {
      "illegal_instruction": true,
      "software_breakpoint": true,
      "hardware_breakpoint": true,
      "load_address_misaligned": true,
      "load_access_fault": true,
      "load_page_fault": true,
      "samo_address_misaligned": true,
      "samo_access_fault": true,
      "samo_page_fault": true,
      "fetch_address_misaligned": true,
      "fetch_access_fault": true,
      "fetch_page_fault": true,
      "software_check": true,
      "reserved_exceptions": false
    },
    "reserved_behavior": {
      "amocas_odd_register": "AMOCAS_Illegal",
      "fcsr_rm": "Fcsr_RM_Illegal",
      "pmpcfg_write_only": "PMP_ClearPermissions",
      "xenvcfg_cbie": "Xenvcfg_ClearPermissions",
      "xtvec_mode": "Xtvec_Ignore",
      "rv32zdinx_odd_register": "Zdinx_Illegal"
    },
    "mstatus": {
      // FS live only while the F/D residue stands; VS is the profile's state gate (R-07-012).
      "fs_legal_states": "ExtContext_FourState",
      "vs_legal_states": "ExtContext_FourState"
    },
    "privileged_isa_version": "Privileged_ISA_1_13"
  },
  "memory": {
    // R-15-002a: single physical space, 36 bits wide.
    "physaddr_bits": 36,
    // R-15-075: CHERI is the sole memory-protection mechanism; no PMP entries.
    "pmp": {
      "grain": 0,
      "count": 0,
      "usable_count": 0,
      "tor_supported": true,
      "na4_supported": true,
      "napot_supported": true
    },
    // R-15-084: misaligned accesses trap and are never split.
    "misaligned": {
      "exceptions": {
        "load_store": { "Some": "AlignmentException" },
        "vector": { "Some": "AlignmentException" },
        "amo": { "Some": "AlignmentException" },
        "lrsc": "AlignmentException"
      },
      "order_decreasing": false,
      "default_allowed_within_exp": 0,
      "byte_by_byte": false
    },
    "dtb_address": { "len": 64, "value": "0x1000" },
    "regions": [
      // ROM
      {
        "base": { "len": 64, "value": "0x1000" },
        "size": { "len": 64, "value": "0x1000" },
        "attributes": {
          "mem_type": "IOMemory",
          "cacheable": true,
          "coherent": false,
          "executable": false,
          "readable": true,
          "writable": false,
          "read_idempotent": true,
          "write_idempotent": true,
          "misaligned_exceptions": {
            "load_store": { "None": null },
            "vector": { "None": null },
            "amo": "AccessFault"
          },
          "atomic_support": "AMONone",
          "misaligned_atomicity_granule_size_exp": 0,
          "vector_misaligned_atomicity_granule_size_exp": 0,
          "reservability": "RsrvNone",
          "supports_cbo_zero": false,
          "supports_pte_read": false,
          "supports_pte_write": false
        },
        "include_in_device_tree": false
      },
      // MMIO
      {
        "base": { "len": 64, "value": "0x2000000" },
        "size": { "len": 64, "value": "0x10000000" },
        "attributes": {
          "mem_type": "IOMemory",
          "cacheable": false,
          "coherent": true,
          "executable": false,
          "readable": true,
          "writable": true,
          "read_idempotent": false,
          "write_idempotent": false,
          "misaligned_exceptions": {
            "load_store": { "None": null },
            "vector": { "None": null },
            "amo": "AccessFault"
          },
          "atomic_support": "AMONone",
          "misaligned_atomicity_granule_size_exp": 0,
          "vector_misaligned_atomicity_granule_size_exp": 0,
          "reservability": "RsrvNone",
          "supports_cbo_zero": false,
          "supports_pte_read": false,
          "supports_pte_write": false
        },
        "include_in_device_tree": false
      },
      // RAM: 2 GiB at 0x8000_0000, inside the 36-bit space.
      {
        "base": { "len": 64, "value": "0x80000000" },
        "size": { "len": 64, "value": "0x80000000" },
        "attributes": {
          "mem_type": "MainMemory",
          "cacheable": true,
          "coherent": true,
          "executable": true,
          "readable": true,
          "writable": true,
          "read_idempotent": true,
          "write_idempotent": true,
          "misaligned_exceptions": {
            "load_store": { "None": null },
            "vector": { "None": null },
            "amo": "AccessFault"
          },
          // R-15-024: Zaamo-level RMW, no CAS, no reservations.
          "atomic_support": "AMOArithmetic",
          "misaligned_atomicity_granule_size_exp": 0,
          "vector_misaligned_atomicity_granule_size_exp": 0,
          "reservability": "RsrvNone",
          "supports_cbo_zero": true,
          "supports_pte_read": false,
          "supports_pte_write": false
        },
        "include_in_device_tree": true
      }
    ]
  },
  "platform": {
    // R-15-052a: hardwired zero.
    "vendorid": 0,
    "archid": 0,
    "impid": 0,
    "hartid": 0,
    // the CBO block Zicboz allocates and cloadtags groups by (R-15-060, R-15-007q).
    "cache_block_size_exp": 6,
    // no reservations exist (R-15-024); schema requires legal values.
    "reservation": {
      "reservation_set_size_exp": 3,
      "require_exact_reservation_addr": false,
      "invalidate_on_same_hart_store": false
    },
    // mtime/mtimecmp are memory-mapped, programmed directly by the kernel (R-15-063).
    "clint": { "supported": true, "base": 33554432, "size": 786432 },
    "simple_interrupt_generator": { "supported": false, "base": 0 },
    "clock_frequency": 1000000000,
    "instructions_per_tick": 2,
    "wfi_is_nop": false,
    "wfi_available_to_user_mode": false,
    "max_time_to_wait": 10
  },
  "extensions": {
    "M": { "supported": true },
    // A narrowed to Zaamo + Zabha (R-15-024): the umbrella is off, the parts are on.
    "A": { "supported": false },
    // residue: ON only because the validator requires scalar F/D under float-capable V;
    // the profile's vector-FP-without-scalar-FP is the R-15-040 source-level fork.
    "F": { "supported": true, "fflags_dirty_policy": "Fflags_Dirty_Precise" },
    "D": { "supported": true },
    // C-class first: VLEN=256, ELEN=64 (per-class parameterization is M0.8).
    "V": {
      "support_level": "Full",
      "vlen_exp": 8,
      "elen_exp": 6,
      "reserved_behavior": {
        "illegal_vtype": "IllegalVtype_SetVill",
        "vstart_out_of_bounds": "Vstart_Illegal"
      },
      "vl_use_ceil": false,
      "max_index_eew_exp": 6,
      // closest config form to the vstart deletion (R-15-039a); the term itself is M0.6c.
      "vstart": { "zero_required": { "arith": true, "scalar_move": true } }
    },
    // B = Zba+Zbb+Zbs exactly, single-bit only at Zbs (R-15-067).
    "B": { "supported": true },
    "S": { "supported": false },
    "U": { "supported": false },
    "Zic64b": { "supported": false },
    "Zicbom": { "supported": false },
    "Zicbop": { "supported": false },
    "Zicboz": { "supported": true },
    "Ziccamoa": { "supported": false },
    "Ziccamoc": { "supported": false },
    "Ziccif": { "supported": false },
    "Zicclsm": { "supported": false },
    "Zicfilp": { "supported": false },
    "Zicond": { "supported": true },
    "Zicntr": { "supported": false },
    "Zicsr": { "supported": true },
    "Zmmul": { "supported": false },
    "Zaamo": { "supported": true },
    "Zabha": { "supported": true },
    "Zacas": { "supported": false },
    "Zama16b": { "supported": false },
    "Zfa": { "supported": false },
    "Zfbfmin": { "supported": false },
    "Zfh": { "supported": false },
    "Zfhmin": { "supported": false },
    "Zfinx": { "supported": false },
    "Zdinx": { "supported": false },
    "Zca": { "supported": false },
    "Zcf": { "supported": false },
    "Zcd": { "supported": false },
    "Zcb": { "supported": false },
    "Zba": { "supported": false },
    "Zbb": { "supported": false },
    "Zbs": { "supported": false },
    "Zbc": { "supported": false },
    "Zbkb": { "supported": true },
    "Zbkc": { "supported": true },
    "Zbkx": { "supported": true },
    "Zkt": { "supported": true },
    "Zhinx": { "supported": false },
    "Zhinxmin": { "supported": false },
    "Zvfbfmin": { "supported": false },
    "Zvfbfwma": { "supported": false },
    "Zvfh": { "supported": false },
    "Zvfhmin": { "supported": false },
    "Zvbb": { "supported": true },
    "Zvbc": { "supported": true },
    "Zvkb": { "supported": false },
    "Zvkg": { "supported": true },
    "Zvkned": { "supported": true },
    "Zvknha": { "supported": false },
    "Zvknhb": { "supported": true },
    "Zvkt": { "supported": true },
    "Ssccptr": { "supported": false },
    "Sscounterenw": { "supported": false },
    "Sstvala": { "supported": false },
    "Svade": { "supported": false },
    "Svadu": { "supported": false },
    "Svrsw60t59b": { "supported": false },
    "Svnapot": { "supported": false },
    "Ssnpm": { "supported": false, "supported_pmlen_7": false, "supported_pmlen_16": false },
    "Smnpm": { "supported": false, "supported_pmlen_7": false, "supported_pmlen_16": false },
    "Smmpm": { "supported": false, "supported_pmlen_7": false, "supported_pmlen_16": false },
    "Smcntrpmf": { "supported": false },
    "Svbare": { "supported": true, "sfence_vma_illegal_if_svbare_only": true },
    "Sv32": { "supported": false },
    "Sv39": { "supported": false },
    "Sv48": { "supported": false },
    "Sv57": { "supported": false },
    "Stateen": {
      "Smstateen": { "supported": false },
      "Ssstateen": { "supported": false },
      "C_readonly_zero": true,
      "SE0_readonly_zero": false
    },
    "Svpbmt": { "supported": false },
    "Svvptc": { "supported": false }
  }
}
