Module MachineWord.MachineWord := Struct Definition idx : Set. Definition Z_idx : forall _ : BinNums.Z, BinNums.N. Definition N_idx : forall _ : BinNums.N, BinNums.N. Definition nat_idx : forall _ : nat, BinNums.N. Definition idx_Z : forall _ : BinNums.N, BinNums.Z. Definition idx_N : forall _ : BinNums.N, BinNums.N. Definition idx_nat : forall _ : BinNums.N, nat. Parameter Z_idx_Z : forall n : BinNums.N, @eq BinNums.N n (Z_idx (idx_Z n)). Parameter idx_Z_idx : forall (z : BinNums.Z) (_ : BinInt.Z.ge z BinNums.Z0), @eq BinNums.Z (idx_Z (Z_idx z)) z. Parameter nat_idx_Z : forall n : nat, @eq BinNums.N (nat_idx n) (Z_idx (BinInt.Z.of_nat n)). Parameter idx_N_Z_idx : forall z : BinNums.Z, @eq BinNums.N (idx_N (Z_idx z)) (BinInt.Z.to_N z). Definition cast_idx : forall (T : forall _ : BinNums.N, Type@{cast_idx.u0}) (m n : BinNums.N) (_ : T m) (_ : @eq BinNums.N m n), T n. Parameter cast_idx_refl : forall (n : BinNums.N) (T : forall _ : BinNums.N, Type@{cast_idx_refl.u0}) (x : T n) (e : @eq BinNums.N n n), @eq (T n) (@cast_idx T n n x e) x. Definition idx_S : forall _ : BinNums.N, BinNums.N. Definition idx_add : forall (_ : BinNums.N) (_ : BinNums.N), BinNums.N. Definition idx_mul : forall (_ : BinNums.N) (_ : BinNums.N), BinNums.N. Parameter Z_idx_S : forall (z : BinNums.Z) (_ : BinInt.Z.ge z BinNums.Z0), @eq BinNums.N (Z_idx (BinInt.Z.succ z)) (idx_S (Z_idx z)). Parameter idx_Z_idx_mul : forall x y : BinNums.N, @eq BinNums.Z (idx_Z (idx_mul x y)) (BinInt.Z.mul (idx_Z x) (idx_Z y)). Definition word : forall _ : BinNums.N, Set. Definition zeros : forall n : BinNums.N, word n. Definition get_bit : forall (n : BinNums.N) (_ : word n) (_ : BinNums.N), bool. Parameter word_0_eq : forall w w' : word (Z_idx BinNums.Z0), @eq (word (Z_idx BinNums.Z0)) w w'. Parameter get_bit_eq_nat : forall (n : nat) (w v : word (nat_idx n)) (_ : forall (i : nat) (_ : lt i n), @eq bool (@get_bit (nat_idx n) w (nat_idx i)) (@get_bit (nat_idx n) v (nat_idx i))), @eq (word (nat_idx n)) w v. Definition word_to_Z : forall (n : BinNums.N) (_ : word n), BinNums.Z. Definition word_to_N : forall (n : BinNums.N) (_ : word n), BinNums.N. Definition Z_to_word : forall (n : BinNums.N) (_ : BinNums.Z), word n. Definition N_to_word : forall n _ : BinNums.N, word n. Parameter word_to_N_range : forall (n : BinNums.N) (w : word n), BinNat.N.lt (@word_to_N n w) (BinNat.N.pow (BinNums.Npos (BinNums.xO BinNums.xH)) (idx_N n)). Parameter testbit_word_to_N_high : forall (n : BinNums.N) (w : word n) (i : BinNums.N) (_ : BinNat.N.ge i n), @eq bool (BinNat.N.testbit (@word_to_N n w) i) false. Parameter word_to_Z_range : forall (n : BinNums.N) (w : word (BinNat.N.succ n)), Logic.and (BinInt.Z.le (BinInt.Z.opp (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) (idx_Z n))) (@word_to_Z (BinNat.N.succ n) w)) (BinInt.Z.lt (@word_to_Z (BinNat.N.succ n) w) (BinInt.Z.pow (BinNums.Zpos (BinNums.xO BinNums.xH)) (idx_Z n))). Definition ones : forall n : BinNums.N, word n. Definition word_to_bools : forall (n : BinNums.N) (_ : word n), list bool. Definition bools_to_word : forall l : list bool, word (nat_idx (@length bool l)). Parameter word_to_bools_length : forall (n : BinNums.N) (w : word n), @eq nat (@length bool (@word_to_bools n w)) (idx_nat n). Parameter nth_error_lookup : forall (A : Type@{nth_error_lookup.u0}) (l : list A) (i : nat), @eq (option A) (@base.lookup nat A (list A) (@list_basics.list.list_lookup A) i l) (@List.nth_error A l i). Parameter nth_error_rev : forall (A : Type@{nth_error_rev.u0}) (l : list A) (i : nat) (x : A), iff (@eq (option A) (@List.nth_error A l i) (@Some A x)) (Logic.and (@eq (option A) (@List.nth_error A (@List.rev A l) (Nat.sub (Nat.sub (@length A l) i) (S O))) (@Some A x)) (lt i (@length A l))). Parameter word_to_bools_get_bit : forall (n : BinNums.N) (w : word n) (i : nat) (x : bool), iff (@eq (option bool) (@List.nth_error bool (@word_to_bools n w) i) (@Some bool x)) (Logic.and (@eq bool (@get_bit n w (nat_idx (Nat.sub (Nat.sub (idx_nat n) i) (S O)))) x) (lt i (idx_nat n))). Parameter word_to_bools_nth_Some : forall (n : BinNums.N) (w : word n) (i : nat) (x : bool) (_ : gt (idx_nat n) O), iff (@eq (option bool) (@List.nth_error bool (@word_to_bools n w) i) (@Some bool x)) (Logic.and (@eq bool x (BinNat.N.testbit (@word_to_N n w) (BinNat.N.of_nat (Nat.sub (Nat.sub (idx_nat n) i) (S O))))) (lt i (idx_nat n))). Parameter N_of_digits_limit : forall l : list bool, BinNat.N.lt (Ascii.N_of_digits l) (BinNat.N.pow (BinNums.Npos (BinNums.xO BinNums.xH)) (BinNat.N.of_nat (@length bool l))). Parameter nth_error_N_of_digits : forall (l : list bool) (i : nat) (b : bool), iff (@eq (option bool) (@List.nth_error bool l i) (@Some bool b)) (Logic.and (@eq bool (BinNat.N.testbit (Ascii.N_of_digits l) (BinNat.N.of_nat i)) b) (lt i (@length bool l))). Parameter bools_to_word_get_bit : forall (l : list bool) (i : nat) (b : bool), iff (@eq (option bool) (@List.nth_error bool l i) (@Some bool b)) (Logic.and (@eq bool (@get_bit (nat_idx (@length bool l)) (bools_to_word l) (nat_idx (Nat.sub (Nat.sub (@length bool l) i) (S O)))) b) (lt i (@length bool l))). Parameter bools_to_word_nth_Some : forall (l : list bool) (i : nat) (b : bool), iff (@eq (option bool) (@List.nth_error bool l i) (@Some bool b)) (Logic.and (@eq bool b (BinNat.N.testbit (@word_to_N (nat_idx (@length bool l)) (bools_to_word l)) (BinNat.N.of_nat (Nat.sub (Nat.sub (@length bool l) i) (S O))))) (lt i (@length bool l))). Definition slice : forall (m n : BinNums.N) (_ : word m) (_ : BinNums.N), word n. Definition update_slice : forall (m n : BinNums.N) (_ : word m) (_ : BinNums.N) (_ : word n), word m. Definition zero_extend : forall (m n : BinNums.N) (_ : word m), word n. Definition sign_extend : forall (m n : BinNums.N) (_ : word m), word n. Definition concat : forall (m n : BinNums.N) (_ : word m) (_ : word n), word (BinNat.N.add m n). Definition set_bit : forall (n : BinNums.N) (_ : word n) (_ : BinNums.N) (_ : bool), word n. Definition and : forall (n : BinNums.N) (_ : word n) (_ : word n), word n. Definition or : forall (n : BinNums.N) (_ : word n) (_ : word n), word n. Definition xor : forall (n : BinNums.N) (_ : word n) (_ : word n), word n. Definition not : forall (n : BinNums.N) (_ : word n), word n. Definition add : forall (n : BinNums.N) (_ : word n) (_ : word n), word n. Definition sub : forall (n : BinNums.N) (_ : word n) (_ : word n), word n. Definition mul : forall (n : BinNums.N) (_ : word n) (_ : word n), word n. Definition logical_shift_left : forall (n : BinNums.N) (_ : word n) (_ : BinNums.N), word n. Definition logical_shift_right : forall (n : BinNums.N) (_ : word n) (_ : BinNums.N), word n. Definition arith_shift_right : forall (n : BinNums.N) (_ : word n) (_ : BinNums.N), word n. Definition replicate : forall (m : nat) (n : BinNums.N) (_ : word n), word (BinNat.N.mul (BinNat.N.of_nat m) n). Definition eq_dec : forall (n : BinNums.N) (w v : word n), sumbool (@eq (word n) w v) (Logic.not (@eq (word n) w v)). Definition eqb : forall (n : BinNums.N) (_ : word n) (_ : word n), bool. Parameter eqb_true_iff : forall (n : BinNums.N) (w v : word n), iff (@eq bool (@eqb n w v) true) (@eq (word n) w v). Definition reverse_endian : forall (n : BinNums.N) (_ : word n), word n. Definition word_to_binary_string : forall (n : BinNums.N) (_ : word n), String.string. Parameter list_concat_base : forall n : BinNums.N, @eq BinNums.N BinNums.N0 (BinNat.N.mul n (BinNat.N.of_nat (@length (word n) (@nil (word n))))). Parameter list_concat_step : forall (n : BinNums.N) (l : list (word n)) (w : word n), @eq BinNums.N (BinNat.N.add n (BinNat.N.mul n (BinNat.N.of_nat (@length (word n) l)))) (BinNat.N.mul n (BinNat.N.of_nat (@length (word n) (@cons (word n) w l)))). Definition word_list_concat : forall (n : BinNums.N) (l : list (word n)), word (idx_mul n (nat_idx (@length (word n) l))). Definition word_split_list : forall (m n : BinNums.N) (_ : word (idx_mul m n)), list (word m). End
