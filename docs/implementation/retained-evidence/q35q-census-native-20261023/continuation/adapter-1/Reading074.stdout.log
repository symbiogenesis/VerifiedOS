Module TypeCasts := Struct Module Z_eq_dec Module ZEqdep Parameter dummy : forall (T : Type@{dummy.u0}) (_ : T), T. Definition dummy_value : forall (T : Type@{dummy_value.u0}) (_ : base.Inhabited T), T. Definition cast_nat : forall (T : forall _ : nat, Type@{cast_nat.u0}) (m n : nat) (_ : T m) (_ : @eq nat m n), T n. Parameter cast_nat_refl : forall (n : nat) (T : forall _ : nat, Type@{cast_nat_refl.u0}) (x : T n) (e : @eq nat n n), @eq (T n) (@cast_nat T n n x e) x. Definition cast_positive : forall (T : forall _ : BinNums.positive, Type@{cast_positive.u0}) (p q : BinNums.positive) (_ : T p) (_ : @eq BinNums.positive p q), T q. Definition cast_N : forall (T : forall _ : BinNums.N, Type@{cast_N.u0}) (m n : BinNums.N) (_ : T m) (_ : @eq BinNums.N m n), T n. Definition cast_Z : forall (T : forall _ : BinNums.Z, Type@{cast_Z.u0}) (m n : BinNums.Z) (_ : T m) (_ : @eq BinNums.Z m n), T n. Parameter cast_positive_refl : forall (p : BinNums.positive) (T : forall _ : BinNums.positive, Type@{cast_positive_refl.u0}) (x : T p) (e : @eq BinNums.positive p p), @eq (T p) (cast_positive T p p x e) x. Parameter cast_N_refl : forall (T : forall _ : BinNums.N, Type@{cast_N_refl.u0}) (m : BinNums.N) (H : @eq BinNums.N m m) (x : T m), @eq (T m) (@cast_N T m m x H) x. Parameter cast_Z_refl : forall (T : forall _ : BinNums.Z, Type@{cast_Z_refl.u0}) (m : BinNums.Z) (H : @eq BinNums.Z m m) (x : T m), @eq (T m) (@cast_Z T m m x H) x. Definition autocast : forall (T : forall _ : BinNums.Z, Type@{autocast.u0}) (m n : BinNums.Z) (_ : base.Inhabited (T n)) (_ : T m), T n. Parameter autocast_refl : forall (T : forall _ : BinNums.Z, Type@{autocast_refl.u0}) (n : BinNums.Z) (Inhabited0 : base.Inhabited (T n)) (x : T n), @eq (T n) (@autocast T n n Inhabited0 x) x. Parameter autocast_eq : forall (T : forall _ : BinNums.Z, Type@{autocast_eq.u0}) (m n : BinNums.Z) (Inhabited0 : base.Inhabited (T n)) (x : T m) (EQ : @eq BinNums.Z m n), @eq (T n) (@autocast T m n Inhabited0 x) (@cast_Z T m n x EQ). Parameter autocast_eq_dep : forall (T : forall _ : BinNums.Z, Type@{autocast_eq_dep.u0}) (m n : BinNums.Z) (Inhabited0 : base.Inhabited (T n)) (x : T m) (_ : @eq BinNums.Z m n), EqdepFacts.eq_dep BinNums.Z T m x n (@autocast T m n Inhabited0 x). End
