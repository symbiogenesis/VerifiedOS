Module GenericValue := Struct Inductive list_all@{α ; u u0} (A : Type@{u}) (PA : forall _ : A, Type@{α ; u0}) : forall _ : list A, Type@{max(Set,u,u0)} :=  nil_all : list_all@{α ; u u0} A PA (@nil A) | cons_all : forall (a : A) (_ : PA a) (l : list A) (_ : list_all@{α ; u u0} A PA l), list_all@{α ; u u0} A PA (@cons A a l).
                              (* α ; *u *u0 |  *) Definition list_all_rect : forall (A : Type@{u}) (PA : forall _ : A, Type@{α ; u0}) (P : forall (l : list A) (_ : list_all@{α ; u u0} A PA l), Type@{u1}) (_ : P (@nil A) (nil_all@{α ; u u0} A PA)) (_ : forall (a : A) (p : PA a) (l : list A) (l0 : list_all@{α ; u u0} A PA l) (_ : P l l0), P (@cons A a l) (cons_all@{α ; u u0} A PA a p l l0)) (l : list A) (l0 : list_all@{α ; u u0} A PA l), P l l0.
                                                    (* α ; u u0 u1 |  *) Definition list_all_ind : forall (A : Type@{u}) (PA : forall _ : A, Type@{α ; u0}) (P : forall (l : list A) (_ : list_all@{α ; u u0} A PA l), Prop) (_ : P (@nil A) (nil_all@{α ; u u0} A PA)) (_ : forall (a : A) (p : PA a) (l : list A) (l0 : list_all@{α ; u u0} A PA l) (_ : P l l0), P (@cons A a l) (cons_all@{α ; u u0} A PA a p l l0)) (l : list A) (l0 : list_all@{α ; u u0} A PA l), P l l0.
                                                                           (* α ; u u0 |  *) Definition list_all_rec : forall (A : Type@{u}) (PA : forall _ : A, Type@{α ; u0}) (P : forall (l : list A) (_ : list_all@{α ; u u0} A PA l), Set) (_ : P (@nil A) (nil_all@{α ; u u0} A PA)) (_ : forall (a : A) (p : PA a) (l : list A) (l0 : list_all@{α ; u u0} A PA l) (_ : P l l0), P (@cons A a l) (cons_all@{α ; u u0} A PA a p l l0)) (l : list A) (l0 : list_all@{α ; u u0} A PA l), P l l0.
                                                                                               (* α ; u u0 |  *) Definition list_all_forall : forall (A : Type@{u}) (PA : forall _ : A, Type@{α ; u0}) (_ : forall a : A, PA a) (l : list A), list_all@{α ; u u0} A PA l.
                                                                                                                   (* α ; u u0 |  *) Inductive prod_all@{α α0 ; u u0 u1 u2} (A : Type@{u}) (PA : forall _ : A, Type@{α ; u1}) (B : Type@{u0}) (PB : forall _ : B, Type@{α0 ; u2}) : forall _ : prod A B, Type@{max(u,u0,u1,u2)} :=  pair_all : forall (a : A) (_ : PA a) (b : B) (_ : PB b), prod_all@{α α0 ; u u0 u1 u2} A PA B PB (@pair A B a b).
                                                                                                                                     (* α α0 ; *u *u0 *u1 *u2 |  *) Definition prod_all_rect : forall (A : Type@{u}) (PA : forall _ : A, Type@{α ; u1}) (B : Type@{u0}) (PB : forall _ : B, Type@{α0 ; u2}) (P : forall (p : prod A B) (_ : prod_all@{α α0 ; u u0 u1 u2} A PA B PB p), Type@{u3}) (_ : forall (a : A) (p : PA a) (b : B) (p0 : PB b), P (@pair A B a b) (pair_all@{α α0 ; u u0 u1 u2} A PA B PB a p b p0)) (p : prod A B) (p0 : prod_all@{α α0 ; u u0 u1 u2} A PA B PB p), P p p0.
                                                                                                                                                                      (* α α0 ; u u0 u1 u2 u3 |  *) Definition prod_all_ind : forall (A : Type@{u}) (PA : forall _ : A, Type@{α ; u1}) (B : Type@{u0}) (PB : forall _ : B, Type@{α0 ; u2}) (P : forall (p : prod A B) (_ : prod_all@{α α0 ; u u0 u1 u2} A PA B PB p), Prop) (_ : forall (a : A) (p : PA a) (b : B) (p0 : PB b), P (@pair A B a b) (pair_all@{α α0 ; u u0 u1 u2} A PA B PB a p b p0)) (p : prod A B) (p0 : prod_all@{α α0 ; u u0 u1 u2} A PA B PB p), P p p0.
                                                                                                                                                                                                      (* α α0 ; u u0 u1 u2 |  *) Definition prod_all_rec : forall (A : Type@{u}) (PA : forall _ : A, Type@{α ; u1}) (B : Type@{u0}) (PB : forall _ : B, Type@{α0 ; u2}) (P : forall (p : prod A B) (_ : prod_all@{α α0 ; u u0 u1 u2} A PA B PB p), Set) (_ : forall (a : A) (p : PA a) (b : B) (p0 : PB b), P (@pair A B a b) (pair_all@{α α0 ; u u0 u1 u2} A PA B PB a p b p0)) (p : prod A B) (p0 : prod_all@{α α0 ; u u0 u1 u2} A PA B PB p), P p p0.
                                                                                                                                                                                                                                   (* α α0 ; u u0 u1 u2 |  *) Definition prod_all_forall : forall (A : Type@{u}) (PA : forall _ : A, Type@{α ; u1}) (_ : forall a : A, PA a) (B : Type@{u0}) (PB : forall _ : B, Type@{α0 ; u2}) (_ : forall b : B, PB b) (p : prod A B), prod_all@{α α0 ; u u0 u1 u2} A PA B PB p.
                                                                                                                                                                                                                                                                (* α α0 ; u u0 u1 u2 |  *) Inductive generic_value : Set :=  GVNumber : forall _ : BinNums.Z, generic_value | GVString : forall _ : String.string, generic_value | GVArray : forall _ : list generic_value, generic_value | GVStruct : forall _ : list (prod String.string generic_value), generic_value. Definition generic_value_rect : forall (P : forall _ : generic_value, Type@{generic_value_rect.u0}) (_ : forall z : BinNums.Z, P (GVNumber z)) (_ : forall s : String.string, P (GVString s)) (_ : forall (l : list generic_value) (_ : list_all@{Type ; Set generic_value_rect.u0} generic_value P l), P (GVArray l)) (_ : forall (l : list (prod String.string generic_value)) (_ : list_all@{Type ; Set generic_value_rect.u1} (prod String.string generic_value) (prod_all@{Type Type ; Set Set Set generic_value_rect.u0} String.string (fun _ : String.string => unit) generic_value P) l), P (GVStruct l)) (g : generic_value), P g. Definition generic_value_ind : forall (P : forall _ : generic_value, Prop) (_ : forall z : BinNums.Z, P (GVNumber z)) (_ : forall s : String.string, P (GVString s)) (_ : forall (l : list generic_value) (_ : list_all@{Prop ; Set Set} generic_value P l), P (GVArray l)) (_ : forall (l : list (prod String.string generic_value)) (_ : list_all@{Type ; Set Set} (prod String.string generic_value) (prod_all@{Type Prop ; Set Set Set Set} String.string (fun _ : String.string => unit) generic_value P) l), P (GVStruct l)) (g : generic_value), P g. Definition generic_value_rec : forall (P : forall _ : generic_value, Set) (_ : forall z : BinNums.Z, P (GVNumber z)) (_ : forall s : String.string, P (GVString s)) (_ : forall (l : list generic_value) (_ : list_all@{Type ; Set Set} generic_value P l), P (GVArray l)) (_ : forall (l : list (prod String.string generic_value)) (_ : list_all@{Type ; Set Set} (prod String.string generic_value) (prod_all@{Type Type ; Set Set Set Set} String.string (fun _ : String.string => unit) generic_value P) l), P (GVStruct l)) (g : generic_value), P g. Record GenericUpdate (T : Type@{GenericUpdate.u0}) : Type@{max(Set,GenericUpdate.u0)} := Build_GenericUpdate { generic_update : forall (_ : generic_value) (_ : T), Values.result T String.string }. Definition generic_update : forall (T : Type@{GenericUpdate.u0}) (_ : GenericUpdate T) (_ : generic_value) (_ : T), Values.result T String.string. Record ToGeneric (T : Type@{ToGeneric.u0}) : Type@{max(Set,ToGeneric.u0)} := Build_ToGeneric { to_generic : forall _ : T, generic_value }. Definition to_generic : forall (T : Type@{ToGeneric.u0}) (_ : ToGeneric T) (_ : T), generic_value. Definition update_unit : GenericUpdate unit. Definition to_generic_unit : ToGeneric unit. Definition update_Z : GenericUpdate BinNums.Z. Definition to_generic_Z : ToGeneric BinNums.Z. Definition update_bitvector : forall n : BinNums.Z, GenericUpdate (Values.mword n). Definition to_generic_bitvector : forall n : BinNums.Z, ToGeneric (Values.mword n). Definition update_enum_type : forall (T : Type@{update_enum_type.u0}) (_ : generic_value) (_ : list (prod String.string T)) (_ : T), Values.result T String.string. Definition update_bool : GenericUpdate bool. Definition to_generic_bool : ToGeneric bool. Definition update_prod2 : forall (T1 : Type@{update_prod2.u0}) (T2 : Type@{update_prod2.u1}) (_ : GenericUpdate T1) (_ : GenericUpdate T2), GenericUpdate (prod T1 T2). Definition to_generic_prod2 : forall (T1 : Type@{to_generic_prod2.u0}) (T2 : Type@{to_generic_prod2.u1}) (_ : ToGeneric T1) (_ : ToGeneric T2), ToGeneric (prod T1 T2). Definition update_prod3 : forall (T1 : Type@{update_prod3.u0}) (T2 : Type@{update_prod3.u1}) (T3 : Type@{update_prod3.u2}) (_ : GenericUpdate T1) (_ : GenericUpdate T2) (_ : GenericUpdate T3), GenericUpdate (prod (prod T1 T2) T3). Definition to_generic_prod3 : forall (T1 : Type@{to_generic_prod3.u0}) (T2 : Type@{to_generic_prod3.u1}) (T3 : Type@{to_generic_prod3.u2}) (_ : ToGeneric T1) (_ : ToGeneric T2) (_ : ToGeneric T3), ToGeneric (prod (prod T1 T3) T2). Definition update_prod4 : forall (T1 : Type@{update_prod4.u0}) (T2 : Type@{update_prod4.u1}) (T3 : Type@{update_prod4.u2}) (T4 : Type@{update_prod4.u3}) (_ : GenericUpdate T1) (_ : GenericUpdate T2) (_ : GenericUpdate T3) (_ : GenericUpdate T4), GenericUpdate (prod (prod (prod T1 T2) T3) T4). Definition to_generic_prod4 : forall (T1 : Type@{to_generic_prod4.u0}) (T2 : Type@{to_generic_prod4.u1}) (T3 : Type@{to_generic_prod4.u2}) (T4 : Type@{to_generic_prod4.u3}) (_ : ToGeneric T1) (_ : ToGeneric T2) (_ : ToGeneric T3) (_ : ToGeneric T4), ToGeneric (prod (prod (prod T1 T2) T3) T4). Definition update_prod5 : forall (T1 : Type@{update_prod5.u0}) (T2 : Type@{update_prod5.u1}) (T3 : Type@{update_prod5.u2}) (T4 : Type@{update_prod5.u3}) (T5 : Type@{update_prod5.u4}) (_ : GenericUpdate T1) (_ : GenericUpdate T2) (_ : GenericUpdate T3) (_ : GenericUpdate T4) (_ : GenericUpdate T5), GenericUpdate (prod (prod (prod (prod T1 T2) T3) T4) T5). Definition to_generic_prod5 : forall (T1 : Type@{to_generic_prod5.u0}) (T2 : Type@{to_generic_prod5.u1}) (T3 : Type@{to_generic_prod5.u2}) (T4 : Type@{to_generic_prod5.u3}) (T5 : Type@{to_generic_prod5.u4}) (_ : ToGeneric T1) (_ : ToGeneric T2) (_ : ToGeneric T3) (_ : ToGeneric T4) (_ : ToGeneric T5), ToGeneric (prod (prod (prod (prod T1 T2) T3) T4) T5). Definition update_prod6 : forall (T1 : Type@{update_prod6.u0}) (T2 : Type@{update_prod6.u1}) (T3 : Type@{update_prod6.u2}) (T4 : Type@{update_prod6.u3}) (T5 : Type@{update_prod6.u4}) (T6 : Type@{update_prod6.u5}) (_ : GenericUpdate T1) (_ : GenericUpdate T2) (_ : GenericUpdate T3) (_ : GenericUpdate T4) (_ : GenericUpdate T5) (_ : GenericUpdate T6), GenericUpdate (prod (prod (prod (prod (prod T1 T2) T3) T4) T5) T6). Definition to_generic_prod6 : forall (T1 : Type@{to_generic_prod6.u0}) (T2 : Type@{to_generic_prod6.u1}) (T3 : Type@{to_generic_prod6.u2}) (T4 : Type@{to_generic_prod6.u3}) (T5 : Type@{to_generic_prod6.u4}) (T6 : Type@{to_generic_prod6.u5}) (_ : ToGeneric T1) (_ : ToGeneric T2) (_ : ToGeneric T3) (_ : ToGeneric T4) (_ : ToGeneric T5) (_ : ToGeneric T6), ToGeneric (prod (prod (prod (prod (prod T1 T2) T3) T4) T5) T6). Definition update_option : forall (T : Type@{update_option.u0}) (_ : base.Inhabited T) (_ : GenericUpdate T), GenericUpdate (option T). Definition to_generic_option : forall (T : Type@{to_generic_option.u0}) (_ : ToGeneric T), ToGeneric (option T). Definition update_list_aux : forall (T : Type@{update_list_aux.u0}) (_ : base.Inhabited T) (_ : GenericUpdate T) (_ : list generic_value) (_ : list T), Values.result (list T) String.string. Definition update_list : forall (T : Type@{update_list.u0}) (_ : base.Inhabited T) (_ : GenericUpdate T), GenericUpdate (list T). Definition to_generic_list : forall (T : Type@{to_generic_list.u0}) (_ : ToGeneric T), ToGeneric (list T). Definition update_vec_aux : forall (T : Type@{update_vec_aux.u0}) (_ : GenericUpdate T) (_ : list generic_value) (_ : list T), Values.result (list T) String.string. Parameter update_vec_aux_length : forall (T : Type@{update_vec_aux_length.u0}) (H : GenericUpdate T) (n : BinNums.Z) (l : list generic_value) (prev : Values.vec T n) (l' : list T) (_ : @eq (Values.result (list T) String.string) (@GenericValue.update_vec_aux T H l (@projT1 (list T) (fun l0 : list T => @eq nat (@length T l0) (BinInt.Z.to_nat n)) prev)) (@Values.Ok (list T) String.string l')), @eq nat (@length T l') (BinInt.Z.to_nat n). Definition update_vec : forall (T : Type@{update_vec.u0}) (n : BinNums.Z) (_ : GenericUpdate T), GenericUpdate (Values.vec T n). Definition to_generic_vec : forall (T : Type@{to_generic_vec.u0}) (n : BinNums.Z) (_ : ToGeneric T), ToGeneric (Values.vec T n). Definition update_string : GenericUpdate String.string. Definition to_generic_string : ToGeneric String.string. End
