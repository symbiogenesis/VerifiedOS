Module CensusControls.Concrete := Struct Definition T : Set. Definition value : T. Inductive answer : Set :=  yes : answer | no : answer. Definition answer_rect : forall (P : forall _ : answer, Type@{answer_rect.u0}) (_ : P yes) (_ : P no) (a : answer), P a. Definition answer_ind : forall (P : forall _ : answer, Prop) (_ : P yes) (_ : P no) (a : answer), P a. Definition answer_rec : forall (P : forall _ : answer, Set) (_ : P yes) (_ : P no) (a : answer), P a. End
