outcome (eOutcome : forall _ : Type@{Interface.T.u0}, Type@{Interface.T.u1})
  : forall _ : Type@{Interface.outcome.u0},
    Type@{max(Set,Arch.reg.u0,Arch.reg_type.u0,Arch.pa.u0,Arch.arch_ak.u0,Arch.translation.u0,Arch.trans_start.u0,Arch.trans_end.u0,Arch.barrier.u0,Arch.cache_op.u0,Arch.tlb_op.u0,Arch.fault.u0,Arch.sys_reg_id.u0,Interface.T.u1,Interface.outcome.u1+1)} :=
    RegRead : forall (reg : A.reg) (_ : option A.sys_reg_id),
