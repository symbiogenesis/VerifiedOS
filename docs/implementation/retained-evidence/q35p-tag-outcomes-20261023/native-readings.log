  | InstrAnnounce : forall _ : definitions.bvn, I.outcome eOutcome unit
  | BranchAnnounce : forall (sz : Z) (_ : mword sz), I.outcome eOutcome unit
  | Barrier : forall _ : A.barrier, I.outcome eOutcome unit
  | CacheOp : forall _ : A.cache_op, I.outcome eOutcome unit
  | TlbOp : forall _ : A.tlb_op, I.outcome eOutcome unit
