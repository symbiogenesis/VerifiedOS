  | TagRead : forall _ : mword (Zpos (xO (xO (xO (xO (xO (xO xH))))))),
              I.outcome eOutcome bool
  | TagWrite : forall (_ : mword (Zpos (xO (xO (xO (xO (xO (xO xH))))))))
