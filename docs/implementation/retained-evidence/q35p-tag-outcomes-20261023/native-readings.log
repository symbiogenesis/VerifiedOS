L.interpret =
fix interpret
  (E : forall _ : Type@{TagOutcomeLaws.interpret.u0},
       Type@{TagOutcomeLaws.interpret.u1})
  (B : Type@{TagOutcomeLaws.interpret.u2}) (m : L.I.iMon E B) 
  (s : L.tags) {struct m} : L.I.iMon E (prod B L.tags) :=
  match m return L.I.iMon E (prod B L.tags) with
  | @L.I.Ret _ _ b => @L.I.Ret E (prod B L.tags) (@pair B L.tags b s)
  | @L.I.Next _ _ T oc k0 =>
      let k : forall (_ : T) (_ : L.tags), L.I.iMon E (prod B L.tags) :=
        fun (x : T) (s' : L.tags) => interpret E B (k0 x) s' in
      match
        oc in L.I.outcome _ T0
        return
          (forall
             _ : forall (_ : T0) (_ : L.tags), L.I.iMon E (prod B L.tags),
           L.I.iMon E (prod B L.tags))
      with
      | @L.I.RegRead _ reg access_kind =>
          fun
            k1 : forall (_ : A.reg_type reg) (_ : L.tags),
                 L.I.iMon E (prod B L.tags) =>
          @L.I.Next E (prod B L.tags) (A.reg_type reg)
            (@L.I.RegRead E reg access_kind)
            (fun x : A.reg_type reg => k1 x s)
      | @L.I.RegWrite _ reg access_kind regval =>
          fun k1 : forall (_ : unit) (_ : L.tags), L.I.iMon E (prod B L.tags) =>
          @L.I.Next E (prod B L.tags) unit
            (@L.I.RegWrite E reg access_kind regval) 
            (fun x : unit => k1 x s)
      | @L.I.MemRead _ n t =>
          fun
            k1 : forall
                   (_ : sum
                          (prod
                             (definitions.bv
                                (N.mul (Npos (xO (xO (xO xH)))) n))
                             (option bool))
                          A.abort)
                   (_ : L.tags),
                 L.I.iMon E (prod B L.tags) =>
          @L.I.Next E (prod B L.tags)
            (sum
               (prod (definitions.bv (N.mul (Npos (xO (xO (xO xH)))) n))
                  (option bool))
               A.abort)
            (@L.I.MemRead E n t)
            (fun
               x : sum
                     (prod
                        (definitions.bv (N.mul (Npos (xO (xO (xO xH)))) n))
                        (option bool))
                     A.abort =>
             k1 x s)
      | @L.I.MemWrite _ n t =>
          fun
            k1 : forall (_ : sum (option bool) A.abort) (_ : L.tags),
                 L.I.iMon E (prod B L.tags) =>
          @L.I.Next E (prod B L.tags) (sum (option bool) A.abort)
            (@L.I.MemWrite E n t)
            (fun x : sum (option bool) A.abort => k1 x s)
      | @L.I.TagRead _ key =>
          fun k1 : forall (_ : bool) (_ : L.tags), L.I.iMon E (prod B L.tags) =>
          k1 (L.tag_get s key) s
      | @L.I.TagWrite _ key value =>
          fun k1 : forall (_ : unit) (_ : L.tags), L.I.iMon E (prod B L.tags) =>
          k1 tt (L.tag_put s key value)
      | @L.I.InstrAnnounce _ opcode =>
          fun k1 : forall (_ : unit) (_ : L.tags), L.I.iMon E (prod B L.tags) =>
          @L.I.Next E (prod B L.tags) unit (@L.I.InstrAnnounce E opcode)
            (fun x : unit => k1 x s)
      | @L.I.BranchAnnounce _ sz pa =>
          fun k1 : forall (_ : unit) (_ : L.tags), L.I.iMon E (prod B L.tags) =>
          @L.I.Next E (prod B L.tags) unit (@L.I.BranchAnnounce E sz pa)
            (fun x : unit => k1 x s)
      | @L.I.Barrier _ b =>
          fun k1 : forall (_ : unit) (_ : L.tags), L.I.iMon E (prod B L.tags) =>
          @L.I.Next E (prod B L.tags) unit (@L.I.Barrier E b)
            (fun x : unit => k1 x s)
      | @L.I.CacheOp _ c =>
          fun k1 : forall (_ : unit) (_ : L.tags), L.I.iMon E (prod B L.tags) =>
          @L.I.Next E (prod B L.tags) unit (@L.I.CacheOp E c)
            (fun x : unit => k1 x s)
      | @L.I.TlbOp _ t =>
          fun k1 : forall (_ : unit) (_ : L.tags), L.I.iMon E (prod B L.tags) =>
          @L.I.Next E (prod B L.tags) unit (@L.I.TlbOp E t)
            (fun x : unit => k1 x s)
      | @L.I.TakeException _ f =>
          fun k1 : forall (_ : unit) (_ : L.tags), L.I.iMon E (prod B L.tags) =>
          @L.I.Next E (prod B L.tags) unit (@L.I.TakeException E f)
            (fun x : unit => k1 x s)
      | @L.I.ReturnException _ pa =>
          fun k1 : forall (_ : unit) (_ : L.tags), L.I.iMon E (prod B L.tags) =>
          @L.I.Next E (prod B L.tags) unit (@L.I.ReturnException E pa)
            (fun x : unit => k1 x s)
      | @L.I.TranslationStart _ t =>
          fun k1 : forall (_ : unit) (_ : L.tags), L.I.iMon E (prod B L.tags) =>
          @L.I.Next E (prod B L.tags) unit (@L.I.TranslationStart E t)
            (fun x : unit => k1 x s)
      | @L.I.TranslationEnd _ t =>
          fun k1 : forall (_ : unit) (_ : L.tags), L.I.iMon E (prod B L.tags) =>
          @L.I.Next E (prod B L.tags) unit (@L.I.TranslationEnd E t)
            (fun x : unit => k1 x s)
      | @L.I.ExtraOutcome _ A y =>
          fun k1 : forall (_ : A) (_ : L.tags), L.I.iMon E (prod B L.tags) =>
          @L.I.Next E (prod B L.tags) A (@L.I.ExtraOutcome E A y)
            (fun x : A => k1 x s)
      | @L.I.GenericFail _ msg =>
          fun
            k1 : forall (_ : False) (_ : L.tags), L.I.iMon E (prod B L.tags) =>
          @L.I.Next E (prod B L.tags) False (@L.I.GenericFail E msg)
            (fun x : False => k1 x s)
      | @L.I.CycleCount _ =>
          fun k1 : forall (_ : unit) (_ : L.tags), L.I.iMon E (prod B L.tags) =>
          @L.I.Next E (prod B L.tags) unit (@L.I.CycleCount E)
            (fun x : unit => k1 x s)
      | @L.I.GetCycleCount _ =>
          fun k1 : forall (_ : Z) (_ : L.tags), L.I.iMon E (prod B L.tags) =>
          @L.I.Next E (prod B L.tags) Z (@L.I.GetCycleCount E)
            (fun x : Z => k1 x s)
      | @L.I.Choose _ ty =>
          fun
            k1 : forall (_ : choose_type ty) (_ : L.tags),
                 L.I.iMon E (prod B L.tags) =>
          @L.I.Next E (prod B L.tags) (choose_type ty) 
            (@L.I.Choose E ty) (fun x : choose_type ty => k1 x s)
      | @L.I.Discard _ =>
          fun
            k1 : forall (_ : False) (_ : L.tags), L.I.iMon E (prod B L.tags) =>
          @L.I.Next E (prod B L.tags) False (@L.I.Discard E)
            (fun x : False => k1 x s)
      | @L.I.Message _ s0 =>
          fun k1 : forall (_ : unit) (_ : L.tags), L.I.iMon E (prod B L.tags) =>
          @L.I.Next E (prod B L.tags) unit (@L.I.Message E s0)
            (fun x : unit => k1 x s)
      end k
  end
     : forall
         {E : forall _ : Type@{TagOutcomeLaws.interpret.u0},
              Type@{TagOutcomeLaws.interpret.u1}}
         {B : Type@{TagOutcomeLaws.interpret.u2}} 
         (_ : L.I.iMon E B) (_ : L.tags),
       L.I.iMon E (prod B L.tags)

