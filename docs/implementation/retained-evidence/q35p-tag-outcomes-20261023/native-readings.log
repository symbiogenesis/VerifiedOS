  | ReturnException : forall _ : A.pa, I.outcome eOutcome unit
  | TranslationStart : forall _ : A.trans_start, I.outcome eOutcome unit
  | TranslationEnd : forall _ : A.trans_end, I.outcome eOutcome unit
  | ExtraOutcome : forall (A : Type@{Interface.outcome.u1}) (_ : eOutcome A),
