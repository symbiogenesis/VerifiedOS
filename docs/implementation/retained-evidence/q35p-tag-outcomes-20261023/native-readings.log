I.map_extra_iMon =
fix map_extra_iMon
  (out1 : forall _ : Type@{Interface.map_extra_iMon.u0},
          Type@{Interface.map_extra_iMon.u1})
  (out2 : forall _ : Type@{Interface.map_extra_iMon.u2},
          Type@{Interface.map_extra_iMon.u3})
  (B : Type@{Interface.map_extra_iMon.u4}) (f : I.iMonExtraMap out1 out2)
  (mon : I.iMon out1 B) {struct mon} : I.iMon out2 B :=
  match mon return I.iMon out2 B with
  | @I.Ret _ _ b => @I.Ret out2 B b
  | @I.Next _ _ T oc k0 =>
      let k : forall _ : T, I.iMon out2 B :=
        fun x : T => map_extra_iMon out1 out2 B f (k0 x) in
      match
        oc in I.outcome _ T0
        return (forall _ : forall _ : T0, I.iMon out2 B, I.iMon out2 B)
      with
      | @I.RegRead _ reg direct =>
          @I.Next out2 B (A.reg_type reg) (@I.RegRead out2 reg direct)
      | @I.RegWrite _ reg direct val =>
          @I.Next out2 B unit (@I.RegWrite out2 reg direct val)
      | @I.MemRead _ n readreq =>
          @I.Next out2 B
            (sum
               (prod (definitions.bv (N.mul (Npos (xO (xO (xO xH)))) n))
                  (option bool))
               A.abort)
            (@I.MemRead out2 n readreq)
      | @I.MemWrite _ n writereq =>
          @I.Next out2 B (sum (option bool) A.abort)
            (@I.MemWrite out2 n writereq)
      | @I.TagRead _ key => @I.Next out2 B bool (@I.TagRead out2 key)
      | @I.TagWrite _ key value =>
          @I.Next out2 B unit (@I.TagWrite out2 key value)
      | @I.InstrAnnounce _ opcode =>
          @I.Next out2 B unit (@I.InstrAnnounce out2 opcode)
      | @I.BranchAnnounce _ sz pa =>
          @I.Next out2 B unit (@I.BranchAnnounce out2 sz pa)
      | @I.Barrier _ barrier => @I.Next out2 B unit (@I.Barrier out2 barrier)
      | @I.CacheOp _ cache_op =>
          @I.Next out2 B unit (@I.CacheOp out2 cache_op)
      | @I.TlbOp _ tlb_op => @I.Next out2 B unit (@I.TlbOp out2 tlb_op)
      | @I.TakeException _ fault =>
          @I.Next out2 B unit (@I.TakeException out2 fault)
      | @I.ReturnException _ pa =>
          @I.Next out2 B unit (@I.ReturnException out2 pa)
      | @I.TranslationStart _ ts =>
          @I.Next out2 B unit (@I.TranslationStart out2 ts)
      | @I.TranslationEnd _ te =>
          @I.Next out2 B unit (@I.TranslationEnd out2 te)
      | @I.ExtraOutcome _ A aout => @I.iMon_bind out2 A B (f A aout)
      | @I.GenericFail _ msg =>
          @I.Next out2 B False (@I.GenericFail out2 msg)
      | @I.CycleCount _ => @I.Next out2 B unit (@I.CycleCount out2)
      | @I.GetCycleCount _ => @I.Next out2 B Z (@I.GetCycleCount out2)
      | @I.Choose _ n => @I.Next out2 B (choose_type n) (@I.Choose out2 n)
      | @I.Discard _ => @I.Next out2 B False (@I.Discard out2)
      | @I.Message _ msg => @I.Next out2 B unit (@I.Message out2 msg)
      end k
  end
     : forall
         {out1 : forall _ : Type@{Interface.map_extra_iMon.u0},
                 Type@{Interface.map_extra_iMon.u1}}
         {out2 : forall _ : Type@{Interface.map_extra_iMon.u2},
                 Type@{Interface.map_extra_iMon.u3}}
         {B : Type@{Interface.map_extra_iMon.u4}}
         (_ : I.iMonExtraMap out1 out2) (_ : I.iMon out1 B),
       I.iMon out2 B

Arguments I.map_extra_iMon {out1 out2}%_function_scope {B}%_type_scope f mon
D.try_catch =
fix try_catch
  (A : Type@{Defs.try_catch.u1}) (E1 : Type@{Defs.try_catch.u0})
  (E2 : Type@{Defs.try_catch.u2}) (m : D.monad E1 A)
  (h : forall _ : E1, D.monad E2 A) {struct m} : D.monad E2 A :=
  match m return D.monad E2 A with
  | @I.Ret _ _ r => @I.Ret (fun _ : Type@{Interface.T.u0} => E2) A r
  | @I.Next _ _ T o f =>
      match
        o in I.outcome _ T0
        return
          (forall
             _ : forall _ : T0,
                 I.iMon (fun _ : Type@{Interface.T.u0} => E1) A,
           D.monad E2 A)
      with
      | @I.RegRead _ reg direct =>
          fun
            f0 : forall _ : A.reg_type reg,
                 I.iMon (fun _ : Type@{Interface.T.u0} => E1) A =>
          @I.Next (fun _ : Type@{Interface.T.u0} => E2) A 
            (A.reg_type reg)
            (@I.RegRead (fun _ : Type@{Interface.T.u0} => E2) reg direct)
            (fun t : A.reg_type reg => try_catch A E1 E2 (f0 t) h)
      | @I.RegWrite _ reg direct regval =>
          fun
            f0 : forall _ : unit,
                 I.iMon (fun _ : Type@{Interface.T.u0} => E1) A =>
          @I.Next (fun _ : Type@{Interface.T.u0} => E2) A unit
            (@I.RegWrite (fun _ : Type@{Interface.T.u0} => E2) reg direct
               regval)
            (fun t : unit => try_catch A E1 E2 (f0 t) h)
      | @I.MemRead _ n req =>
          fun
            f0 : forall
                   _ : sum
                         (prod
                            (definitions.bv
                               (N.mul (Npos (xO (xO (xO xH)))) n))
                            (option bool))
                         A.abort,
                 I.iMon (fun _ : Type@{Interface.T.u0} => E1) A =>
          @I.Next (fun _ : Type@{Interface.T.u0} => E2) A
            (sum
               (prod (definitions.bv (N.mul (Npos (xO (xO (xO xH)))) n))
                  (option bool))
               A.abort)
            (@I.MemRead (fun _ : Type@{Interface.T.u0} => E2) n req)
            (fun
               t : sum
                     (prod
                        (definitions.bv (N.mul (Npos (xO (xO (xO xH)))) n))
                        (option bool))
                     A.abort =>
             try_catch A E1 E2 (f0 t) h)
      | @I.MemWrite _ n req =>
          fun
            f0 : forall _ : sum (option bool) A.abort,
                 I.iMon (fun _ : Type@{Interface.T.u0} => E1) A =>
          @I.Next (fun _ : Type@{Interface.T.u0} => E2) A
            (sum (option bool) A.abort)
            (@I.MemWrite (fun _ : Type@{Interface.T.u0} => E2) n req)
            (fun t : sum (option bool) A.abort => try_catch A E1 E2 (f0 t) h)
      | @I.TagRead _ key =>
          fun
            f0 : forall _ : bool,
                 I.iMon (fun _ : Type@{Interface.T.u0} => E1) A =>
          @I.Next (fun _ : Type@{Interface.T.u0} => E2) A bool
            (@I.TagRead (fun _ : Type@{Interface.T.u0} => E2) key)
            (fun t : bool => try_catch A E1 E2 (f0 t) h)
      | @I.TagWrite _ key value =>
          fun
            f0 : forall _ : unit,
                 I.iMon (fun _ : Type@{Interface.T.u0} => E1) A =>
          @I.Next (fun _ : Type@{Interface.T.u0} => E2) A unit
            (@I.TagWrite (fun _ : Type@{Interface.T.u0} => E2) key value)
            (fun t : unit => try_catch A E1 E2 (f0 t) h)
      | @I.InstrAnnounce _ opcode =>
          fun
            f0 : forall _ : unit,
                 I.iMon (fun _ : Type@{Interface.T.u0} => E1) A =>
          @I.Next (fun _ : Type@{Interface.T.u0} => E2) A unit
            (@I.InstrAnnounce (fun _ : Type@{Interface.T.u0} => E2) opcode)
            (fun t : unit => try_catch A E1 E2 (f0 t) h)
      | @I.BranchAnnounce _ sz pa =>
          fun
            f0 : forall _ : unit,
                 I.iMon (fun _ : Type@{Interface.T.u0} => E1) A =>
          @I.Next (fun _ : Type@{Interface.T.u0} => E2) A unit
            (@I.BranchAnnounce (fun _ : Type@{Interface.T.u0} => E2) sz pa)
            (fun t : unit => try_catch A E1 E2 (f0 t) h)
      | @I.Barrier _ barrier =>
          fun
            f0 : forall _ : unit,
                 I.iMon (fun _ : Type@{Interface.T.u0} => E1) A =>
          @I.Next (fun _ : Type@{Interface.T.u0} => E2) A unit
            (@I.Barrier (fun _ : Type@{Interface.T.u0} => E2) barrier)
            (fun t : unit => try_catch A E1 E2 (f0 t) h)
      | @I.CacheOp _ op =>
          fun
            f0 : forall _ : unit,
                 I.iMon (fun _ : Type@{Interface.T.u0} => E1) A =>
          @I.Next (fun _ : Type@{Interface.T.u0} => E2) A unit
            (@I.CacheOp (fun _ : Type@{Interface.T.u0} => E2) op)
            (fun t : unit => try_catch A E1 E2 (f0 t) h)
      | @I.TlbOp _ op =>
          fun
            f0 : forall _ : unit,
                 I.iMon (fun _ : Type@{Interface.T.u0} => E1) A =>
          @I.Next (fun _ : Type@{Interface.T.u0} => E2) A unit
            (@I.TlbOp (fun _ : Type@{Interface.T.u0} => E2) op)
            (fun t : unit => try_catch A E1 E2 (f0 t) h)
      | @I.TakeException _ fault =>
          fun
            f0 : forall _ : unit,
                 I.iMon (fun _ : Type@{Interface.T.u0} => E1) A =>
          @I.Next (fun _ : Type@{Interface.T.u0} => E2) A unit
            (@I.TakeException (fun _ : Type@{Interface.T.u0} => E2) fault)
            (fun t : unit => try_catch A E1 E2 (f0 t) h)
      | @I.ReturnException _ pa =>
          fun
            f0 : forall _ : unit,
                 I.iMon (fun _ : Type@{Interface.T.u0} => E1) A =>
          @I.Next (fun _ : Type@{Interface.T.u0} => E2) A unit
            (@I.ReturnException (fun _ : Type@{Interface.T.u0} => E2) pa)
            (fun t : unit => try_catch A E1 E2 (f0 t) h)
      | @I.TranslationStart _ ts =>
          fun
            f0 : forall _ : unit,
                 I.iMon (fun _ : Type@{Interface.T.u0} => E1) A =>
          @I.Next (fun _ : Type@{Interface.T.u0} => E2) A unit
