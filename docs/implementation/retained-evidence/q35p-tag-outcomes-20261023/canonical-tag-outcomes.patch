 Definition fail {A E} (msg : string) : monad E A :=
   I.Next (I.GenericFail msg) (fun f => match f with end).
+
+(** Standalone tag operations preserve the raw granule key and native result. *)
+Definition read_tag_bool {E} (key : mword 64) : monad E bool :=
+  I.Next (I.TagRead key) I.Ret.
+Definition write_tag_bool {E} (key : mword 64) (value : bool) : monad E unit :=
+  I.Next (I.TagWrite key value) I.Ret.
 
