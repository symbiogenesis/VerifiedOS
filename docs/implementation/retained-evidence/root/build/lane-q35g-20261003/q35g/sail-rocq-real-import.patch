 let generated_line f = Printf.sprintf "Generated by Sail from %s." f
 
+(* Whether a model uses reals, so that its output needs SailStdpp.Real.  Any
+   real-valued computation has a declaration, expression or pattern whose type
+   mentions real, so the types of all of them are examined. *)
+let typ_uses_real typ = Ast_compare.IdSet.mem (Ast_util.mk_id "real") (Ast_util.ids_of_typ typ)
+
+let typ_arg_uses_real arg = Ast_compare.IdSet.mem (Ast_util.mk_id "real") (Ast_util.ids_of_typ_arg arg)
+
+let annot_uses_real (_, tannot) =
+  match Type_check.destruct_tannot tannot with Some (_, typ) -> typ_uses_real typ | None -> false
+
+let uses_reals defs =
+  let open Ast in
+  let open Rewriter in
+  let pat_alg = { (pure_pat_alg false ( || )) with p_aux = (fun (b, annot) -> b || annot_uses_real annot) } in
+  let alg = { (pure_exp_alg false ( || )) with e_aux = (fun (b, annot) -> b || annot_uses_real annot); pat_alg } in
+  let fundef_uses (FD_aux (FD_function (_, _, funcls), _)) =
+    List.exists (fun (FCL_aux (FCL_funcl (_, pexp), _)) -> fold_pexp alg pexp) funcls
+  in
+  let type_def_uses (TD_aux (td, _)) =
+    match td with
+    | TD_abbrev (_, _, arg) -> typ_arg_uses_real arg
+    | TD_record (_, _, fields, _) -> List.exists (fun ((_, typ), _) -> typ_uses_real typ) fields
+    | TD_variant (_, _, arms, _) -> List.exists (fun (Tu_aux (Tu_ty_id (typ, _), _)) -> typ_uses_real typ) arms
+    | TD_enum _ | TD_abstract _ | TD_bitfield _ -> false
+  in
+  let def_uses (DEF_aux (aux, _)) =
+    match aux with
+    | DEF_type td -> type_def_uses td
+    | DEF_val (VS_aux (VS_val_spec (TypSchm_aux (TypSchm_ts (_, typ), _), _, ext), _)) ->
+        (* An external function's declaration is not part of the output. *)
+        Option.is_none (Ast_util.extern_assoc "coq" ext) && typ_uses_real typ
+    | DEF_register (DEC_aux (DEC_reg (typ, _, exp), _)) -> (
+        typ_uses_real typ || match exp with Some exp -> fold_exp alg exp | None -> false
+      )
+    | DEF_let (pat, exp) -> fold_pat pat_alg pat || fold_exp alg exp
+    | DEF_fundef fd -> fundef_uses fd
+    | DEF_internal_mutrec fds -> List.exists fundef_uses fds
+    | DEF_instantiation (_, substs) ->
+        List.exists (function IS_aux (IS_typ (_, arg), _) -> typ_arg_uses_real arg | _ -> false) substs
+    | _ -> false
+  in
+  List.exists def_uses defs
+
